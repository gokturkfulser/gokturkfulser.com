# VPS'te infra/backup/.env olarak kopyalanır (git'e girmez); chmod 600.
# R2: Cloudflare dashboard > R2 > Manage API tokens > "Object Read & Write",
# yalnızca gokturkfulser-backup bucket'ına kısıtlı token.
RESTIC_REPOSITORY=s3:https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com/gokturkfulser-backup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 için bölge "auto"; restic'in S3 istemcisi bunu ister.
AWS_DEFAULT_REGION=auto
# Repo şifresi. KAYBEDERSEN YEDEKLER AÇILAMAZ; parola yöneticisine ayrıca kaydet.
RESTIC_PASSWORD=

# Saklama politikası (backup.sh her çalışmada uygular)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Yalnızca yerel test için: doluysa bu docker volume /repo olarak bağlanır ve
# RESTIC_REPOSITORY=/repo kullanılır (R2'ye gitmez).
# RESTIC_LOCAL_VOLUME=restic-local-test
