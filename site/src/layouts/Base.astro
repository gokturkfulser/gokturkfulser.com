---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Font } from 'astro:assets';
import { CF_ANALYTICS_TOKEN, SHOW_DRAFTS } from 'astro:env/server';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';
import '../styles/medya.css';
import '../styles/yazdir.css';
import { jsonLdMetni } from '../lib/jsonld';
import { projeler } from '../lib/content';
import { EPOSTA, GITHUB, SITE_ADI } from '../lib/site';
import { AYAR, DILLER, dilAl, digerDil, sozluk, type Dil } from '../i18n';
import { yol, type Esdeger } from '../i18n/yollar';

interface Props {
  baslik?: string;
  aciklama?: string;
  /** Sayfa türü: Open Graph için. */
  tur?: 'website' | 'article';
  /** Site köküne göre OG görseli yolu; verilmezse sayfanın dilindeki ortak görsel. */
  ogGorsel?: string;
  /** schema.org verisi (JSON-LD). */
  jsonLd?: unknown;
  /** Üst çubuk ilk (koyu, görselli) bandın üstüne biner; verilmezse kendi koyu şeridinde durur. */
  bindirme?: boolean;
  /** Sayfanın dili; verilmezse Astro'nun currentLocale'inden (yol önekinden) gelir. Menü, alt bilgi ve <html lang> bu dildedir. */
  dil?: Dil;
  /** Bu sayfanın dillerdeki gerçek karşılıkları (hreflang). Kendisi de yazılabilir; yazılmazsa yalnızca kendisi. */
  esdeger?: Esdeger;
  /** Dil düğmesi için yedek hedefler: gerçek karşılığı olmayan dilde ilgili liste sayfası. Yoksa ana sayfa. */
  yedek?: Esdeger;
  /** 404: canonical ve hreflang yok, noindex. */
  bulunamadi?: boolean;
}

const sayfaDili = dilAl(Astro);
const {
  baslik,
  aciklama,
  tur = 'website',
  jsonLd,
  bindirme = false,
  dil = sayfaDili,
  esdeger = {},
  yedek = {},
  bulunamadi = false,
} = Astro.props;
const s = sozluk(dil);
const diger = digerDil(dil);
const ayar = AYAR[dil];
const ogGorsel = Astro.props.ogGorsel ?? yol.ogVarsayilan(dil);
const tamBaslik = baslik ? `${baslik} · ${SITE_ADI}` : SITE_ADI;
const metaAciklama = aciklama ?? s.site.aciklama;
const yolAdi = Astro.url.pathname;
const canonical = bulunamadi ? undefined : new URL(yolAdi, Astro.site);
const ogUrl = new URL(ogGorsel, Astro.site);

// hreflang: gerçek karşılıklar (kendisi dahil) + x-default (İngilizce; yoksa kendisi).
const karsiliklar: Esdeger = bulunamadi ? {} : { ...esdeger, [dil]: yolAdi };
const alternatifler = DILLER.flatMap((d) => (karsiliklar[d] ? [{ dil: d, href: new URL(karsiliklar[d]!, Astro.site) }] : []));
const xDefault = karsiliklar.en ?? karsiliklar[dil];
const digerKarsilik = alternatifler.filter((a) => a.dil !== dil);
// Dil düğmesi: karşılığı varsa ona, yoksa diğer dilin ilgili liste sayfasına (ya da ana sayfaya).
const gecis = (d: Dil) => karsiliklar[d] ?? yedek[d] ?? yol.ana(d);

// TMDB logosu: site/public/tmdb-logo.svg (ya da .png) varsa footer'da gösterilir; yoksa yalnızca metin atfı.
const tmdbLogo = ['tmdb-logo.svg', 'tmdb-logo.png'].find((f) => existsSync(join(process.cwd(), 'public', f)));

const altProjeler = (await projeler(dil)).filter((p) => p.data.durum !== 'arsiv').slice(0, 4);
const menu = [
  { ad: s.nav.anaSayfa, href: yol.ana(dil), tam: true },
  { ad: s.nav.yazilar, href: yol.yazilar(dil) },
  { ad: s.nav.projeler, href: yol.projeler(dil) },
  { ad: s.nav.hakkimda, href: yol.hakkimda(dil) },
];
const aktifMi = (oge: (typeof menu)[number]) => (oge.tam ? yolAdi === oge.href : yolAdi.startsWith(oge.href));
const profiller = [
  { ad: 'GitHub', href: GITHUB },
  { ad: 'RSS', href: yol.rss(dil) },
];
---

<!doctype html>
<html lang={ayar.lang} data-tire={ayar.tire}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={metaAciklama} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternatifler.map((a) => <link rel="alternate" hreflang={AYAR[a.dil].lang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_ADI} href={yol.rss(dil)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_ADI} />
    <meta property="og:locale" content={ayar.og} />
    {digerKarsilik.map((a) => <meta property="og:locale:alternate" content={AYAR[a.dil].og} />)}
    <meta property="og:type" content={tur} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={metaAciklama} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0c0e" />
    {(SHOW_DRAFTS || bulunamadi) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-baslik" preload />
    <Font cssVariable="--font-metin" preload />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLdMetni(jsonLd)} />}
  </head>
  <body>
    <a class="atla" href="#icerik">{s.nav.atla}</a>
    <header class:list={['ust', bindirme && 'bindirme']}>
      <div class="kap ust-ic">
        <a href={yol.ana(dil)} class="marka">{SITE_ADI}</a>
        <nav class="menu" aria-label={s.nav.anaMenu}>
          <ul class="lista">
            {
              menu.map((oge) => (
                <li>
                  <a href={oge.href} class="sessiz-link" aria-current={aktifMi(oge) ? 'page' : undefined}>
                    {oge.ad}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <!-- Dil anahtarı: tek <a> (gezinme bağlantısı, role="switch" değil), JS yok; her ekran genişliğinde görünür.
             Başparmak aktif dilin altındadır (data-aktif); iki sayfa arasında CSS View Transitions ile kayar. -->
        <a
          class="dil-anahtar"
          data-aktif={dil}
          href={gecis(diger)}
          hreflang={AYAR[diger].lang}
          lang={AYAR[diger].lang}
          aria-label={sozluk(diger).nav.buDileGec}
          rel="alternate"
        >
          <span class="dil-kaydirak" aria-hidden="true"></span>
          {
            DILLER.map((d) => (
              <span class:list={['dil-etiket', d === dil && 'dil-etiket--aktif']} data-d={d} aria-hidden="true">
                {d.toUpperCase()}
              </span>
            ))
          }
        </a>
        <!-- Mobil menü: JS'siz <details>; masaüstünde gizli -->
        <details class="menu-mobil">
          <summary>{s.nav.menu}</summary>
          <nav aria-label={s.nav.anaMenuMobil}>
            <ul class="lista">
              {
                menu.map((oge) => (
                  <li>
                    <a href={oge.href} class="sessiz-link" aria-current={aktifMi(oge) ? 'page' : undefined}>
                      {oge.ad}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
        <a class="ara sessiz-link" href={yol.arama(dil)} aria-label={s.nav.ara} aria-current={yolAdi.startsWith(yol.arama(dil)) ? 'page' : undefined}>
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>
        </a>
      </div>
    </header>
    <main id="icerik">
      <slot />
    </main>
    <footer class="alt">
      <div class="kap">
        <div class="alt-izgara">
          <div class="alt-marka">
            <a class="marka" href={yol.ana(dil)}>{SITE_ADI}</a>
            <p>{s.site.aciklama}</p>
            <p><a href={`mailto:${EPOSTA}`}>{EPOSTA}</a></p>
          </div>
          <nav class="alt-sutun" aria-labelledby="alt-bolumler">
            <h2 id="alt-bolumler">{s.alt.bolumler}</h2>
            <ul class="lista">
              <li><a href={yol.yazilar(dil)}>{s.alt.tumYazilar}</a></li>
              <li><a href={yol.yazilar(dil, 'sinema')}>{s.bolum.sinema}</a></li>
              <li><a href={yol.yazilar(dil, 'basketbol')}>{s.bolum.basketbol}</a></li>
              <li><a href={yol.hakkimda(dil)}>{s.nav.hakkimda}</a></li>
              <li><a href={yol.arama(dil)}>{s.nav.ara}</a></li>
            </ul>
          </nav>
          <nav class="alt-sutun" aria-labelledby="alt-projeler">
            <h2 id="alt-projeler">{s.alt.projeler}</h2>
            <ul class="lista">
              <li><a href={yol.projeler(dil)}>{s.alt.tumProjeler}</a></li>
              {altProjeler.map((p) => <li><a href={yol.proje(dil, p.id)}>{p.data.ad}</a></li>)}
            </ul>
          </nav>
          <nav class="alt-sutun" aria-labelledby="alt-profiller">
            <h2 id="alt-profiller">{s.alt.profiller}</h2>
            <ul class="lista">
              {profiller.map((p) => <li><a href={p.href}>{p.ad}</a></li>)}
            </ul>
          </nav>
        </div>
        <div class="alt-taban">
          <p>© {new Date().getFullYear()} {SITE_ADI}</p>
          <div class="tmdb">
            {
              tmdbLogo && (
                <a class="tmdb-logo" href="https://www.themoviedb.org/" aria-label="TMDB">
                  <img src={`/${tmdbLogo}`} alt="TMDB" height="14" />
                </a>
              )
            }
            <p>
              {s.alt.tmdbOnce}<a href="https://www.themoviedb.org/">TMDB</a>{s.alt.tmdbSonra}<span lang="en">{s.alt.tmdbNot}</span>
            </p>
          </div>
        </div>
      </div>
    </footer>
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </body>
</html>

<style>
  /* Üst çubuk: her zaman koyu, sabit değil (sayfayla kayar). Görselli sayfa başlarında ilk bandın üstüne biner;
     o bandın arkasında karartma (scrim) vardır, kontrast ekran görüntüsünden ölçülür. */
  .ust {
    position: relative;
    z-index: 30;
    background: var(--perde);
    border-block-end: 1px solid #34353a;
    color: #ece8e1;
    /* Üst çubuk her zaman koyu bant tonlarını kullanır */
    --vurgu: #4fd1d9;
    --murekkep: #ece8e1;
    --soluk: #c9c3b8;
  }

  .ust.bindirme {
    position: absolute;
    inset: 0 0 auto 0;
    background: transparent;
    border-block-end: 0;
  }

  .ust-ic {
    display: flex;
    align-items: center;
    gap: var(--aralik-4);
    min-height: var(--nav);
  }

  .marka {
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.005em;
    text-decoration-line: none;
    view-transition-name: marka;
  }

  .menu {
    margin-inline-start: auto;
  }

  .menu ul {
    display: flex;
    gap: 0 var(--aralik-4);
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    font-weight: 500;
  }

  .menu a,
  .ara {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .ara {
    justify-content: center;
    min-width: 2.75rem;
    text-decoration-line: none;
  }

  .ara:hover,
  .ara[aria-current='page'] {
    color: var(--vurgu);
  }

  .menu-mobil {
    display: none;
  }

  /* Dil anahtarı: tek hap, içinde EN ve TR yan yana; aktif dilin altında dolgulu "başparmak". Aktif etiket başparmak üstünde koyu,
     pasif etiket soluk. Tek <a>; hedef alanı pseudo-öğeyle ≥ 44 px. Geçiş: başparmağın view-transition-name'i (base.css). */
  .dil-anahtar {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    inline-size: 5.25rem;
    block-size: 2.25rem;
    padding: 3px;
    box-sizing: border-box;
    border: 1px solid rgb(236 232 225 / 0.45);
    border-radius: 999px;
    background: rgb(11 12 14 / 0.6);
    font-family: var(--font-baslik-yigin);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration-line: none;
    color: var(--soluk);
    isolation: isolate;
  }

  /* Dokunma hedefi: görünür hap 36 px, tıklanabilir alan 44 px yüksekliğinde */
  .dil-anahtar::after {
    content: '';
    position: absolute;
    inset: -0.3125rem -0.25rem;
  }

  .dil-kaydirak {
    grid-row: 1;
    grid-column: 1;
    z-index: -1;
    border-radius: 999px;
    background: var(--murekkep);
    transform-origin: left center;
    transition: transform 0.35s var(--ease);
    view-transition-name: dil-kaydirak;
  }

  .dil-anahtar[data-aktif='tr'] .dil-kaydirak {
    grid-column: 2;
    transform-origin: right center;
  }

  .dil-etiket[data-d='en'] {
    grid-column: 1;
  }

  .dil-etiket[data-d='tr'] {
    grid-column: 2;
  }

  .dil-etiket {
    display: grid;
    place-items: center;
    grid-row: 1;
  }

  .dil-etiket--aktif {
    color: var(--perde);
  }

  /* Hover/odak: başparmak diğer dile doğru hafifçe esner (niyet göstergesi); pasif etiket belirginleşir */
  .dil-anahtar:is(:hover, :focus-visible) .dil-kaydirak {
    transform: scaleX(1.14);
  }

  .dil-anahtar:is(:hover, :focus-visible) .dil-etiket:not(.dil-etiket--aktif) {
    color: var(--murekkep);
  }

  .dil-anahtar:focus-visible {
    outline: 3px solid var(--vurgu);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .dil-kaydirak {
      transition: none;
    }

    .dil-anahtar:is(:hover, :focus-visible) .dil-kaydirak {
      transform: none;
    }
  }

  @media (max-width: 40rem) {
    .dil-anahtar {
      margin-inline-start: auto;
    }

    .dil-anahtar + .menu-mobil {
      margin-inline-start: 0;
    }
  }

  @media (max-width: 40rem) {
    .ust-ic {
      gap: var(--aralik-3);
    }

    .menu {
      display: none;
    }

    .menu-mobil {
      display: block;
      margin-inline-start: auto;
    }

    .menu-mobil summary {
      display: inline-flex;
      align-items: center;
      min-height: 2.5rem;
      padding-inline: 1.125rem;
      border: 1px solid rgb(236 232 225 / 0.45);
      border-radius: 999px;
      background: rgb(11 12 14 / 0.6);
      font-family: var(--font-baslik-yigin);
      font-size: 1rem;
      font-weight: 600;
      list-style: none;
      cursor: pointer;
    }

    .menu-mobil summary::-webkit-details-marker {
      display: none;
    }

    .menu-mobil[open] summary {
      background: #ece8e1;
      color: #0b0c0e;
    }

    .menu-mobil nav {
      position: absolute;
      inset: 100% 0 auto 0;
      padding: var(--aralik-2) var(--kenar) var(--aralik-4);
      background: rgb(11 12 14 / 0.98);
      border-block-end: 1px solid #34353a;
    }

    .menu-mobil nav a {
      display: block;
      padding-block: 0.625rem;
      font-family: var(--font-baslik-yigin);
      font-size: 1.75rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .ara {
      margin-inline-start: 0;
    }
  }

  .alt {
    padding-block: clamp(4rem, 8vw, 7rem) var(--aralik-5);
    background: var(--perde);
    border-block-start: 1px solid var(--cizgi);
    color: var(--soluk);
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    line-height: 1.55;
  }

  .alt-izgara {
    display: grid;
    grid-template-columns: 1.7fr repeat(3, minmax(0, 1fr));
    gap: var(--aralik-5) var(--aralik-4);
  }

  .alt-marka {
    display: grid;
    gap: var(--aralik-2);
    align-content: start;
    max-width: 30ch;
  }

  /* Serif yalnızca ≥ 24 px: footer adı 2 rem (32 px) */
  .alt-marka .marka {
    justify-self: start;
    margin-block-end: var(--aralik-2);
    font-family: var(--font-serif-yigin);
    font-size: 2.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--murekkep);
    view-transition-name: none;
  }

  .alt-marka p {
    margin: 0;
  }

  .alt-sutun h2 {
    margin-block-end: var(--aralik-3);
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--murekkep);
  }

  .alt-sutun li + li {
    margin-block-start: 0.375rem;
  }

  .alt-taban {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--aralik-3) var(--aralik-5);
    margin-block-start: clamp(3rem, 6vw, 5rem);
    padding-block-start: var(--aralik-4);
    border-block-start: 1px solid var(--cizgi);
    font-size: var(--yazi-xs);
  }

  .alt-taban > p {
    margin: 0;
  }

  @media (max-width: 52rem) {
    .alt-izgara {
      grid-template-columns: 1fr 1fr;
    }

    .alt-marka {
      grid-column: 1 / -1;
    }
  }

  .tmdb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--aralik-2) var(--aralik-3);
    max-width: 70ch;
    font-size: var(--yazi-xs);
  }

  .tmdb p {
    margin: 0;
    flex: 1 1 24ch;
  }

  /* TMDB logosu bu sitenin kendi başlığından belirgin olmamalı: küçük, tek renk kalır */
  .tmdb-logo img {
    display: block;
    width: auto;
    height: 0.875rem;
  }
</style>
