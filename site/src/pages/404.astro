---
import Base from '../layouts/Base.astro';
---

<Base baslik="Sayfa bulunamadı" aciklama="Aradığınız sayfa bulunamadı.">
  <section class="bant bant--koyu sayfa" aria-labelledby="yok-baslik">
    <div class="kap yok">
      <h1 id="yok-baslik" class="h1">Sayfa bulunamadı</h1>
      <p class="lede">Adres yanlış yazılmış ya da sayfa taşınmış olabilir.</p>
      <p class="geri"><a href="/">Ana sayfaya dön</a></p>
    </div>
  </section>
</Base>

<style>
  .sayfa {
    min-height: calc(100svh - var(--nav));
    display: grid;
    align-items: center;
  }

  .yok {
    display: grid;
    gap: var(--aralik-3);
  }

  .geri {
    margin: var(--aralik-3) 0 0;
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 600;
  }
</style>
