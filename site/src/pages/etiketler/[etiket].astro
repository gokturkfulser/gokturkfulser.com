---
import Base from '../../layouts/Base.astro';
import YaziSatiri from '../../components/YaziSatiri.astro';
import { etiketHaritasi } from '../../lib/content';

export async function getStaticPaths() {
  const harita = await etiketHaritasi();
  return [...harita].map(([slug, kayit]) => ({
    params: { etiket: slug },
    props: { ad: kayit.ad, yazilar: kayit.yazilar },
  }));
}

const { ad, yazilar } = Astro.props;
---

<Base baslik={`#${ad}`} aciklama={`“${ad}” etiketli yazılar.`}>
  <section class="bant bant--koyu bant--basi" aria-labelledby="etiket-baslik">
    <div class="kap">
      <h1 id="etiket-baslik" class="h1">#{ad}</h1>
      <p class="lede">“{ad}” etiketli yazılar.</p>
    </div>
  </section>
  <section class="bant bant--acik" aria-label="Etiketli yazılar">
    <div class="kap">
      <ul class="lista">
        {
          yazilar.map((yazi) => (
            <li>
              <YaziSatiri yazi={yazi} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
