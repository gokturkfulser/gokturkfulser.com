---
import Base from '../../layouts/Base.astro';
import YaziSatiri from '../../components/YaziSatiri.astro';
import { etiketHaritasi } from '../../lib/content';

export async function getStaticPaths() {
  const harita = await etiketHaritasi();
  return [...harita].map(([slug, kayit]) => ({
    params: { etiket: slug },
    props: { ad: kayit.ad, yazilar: kayit.yazilar },
  }));
}

const { ad, yazilar } = Astro.props;
---

<Base baslik={`#${ad}`} aciklama={`“${ad}” etiketli yazılar.`}>
  <div class="kap sayfa">
    <h1>#{ad}</h1>
    <ul class="lista akis">
      {
        yazilar.map((yazi) => (
          <li>
            <YaziSatiri yazi={yazi} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .sayfa {
    padding-block: var(--aralik-5) var(--aralik-6);
  }

  h1 {
    margin-block-end: var(--aralik-5);
    font-size: var(--yazi-h1);
    letter-spacing: -0.01em;
  }

  .akis {
    display: grid;
    gap: var(--aralik-5);
  }
</style>
