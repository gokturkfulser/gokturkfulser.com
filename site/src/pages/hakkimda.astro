---
import { SHOW_DRAFTS } from 'astro:env/server';
import Base from '../layouts/Base.astro';
import DeneyimZamanCizelgesi from '../components/DeneyimZamanCizelgesi.astro';

// Gerçek deneyim girilince bu liste doldurulur; boşken zaman çizelgesi hiç çizilmez.
const deneyim = SHOW_DRAFTS
  ? [
      { donem: '2024 – şimdi', baslik: 'Yazılım geliştirici', kurum: 'Örnek Şirket', aciklama: 'Yer tutucu: gerçek deneyim girilecek.' },
      { donem: '2020 – 2024', baslik: 'Yazılım mühendisi', kurum: 'Örnek Kurum', aciklama: 'Yer tutucu: gerçek deneyim girilecek.' },
    ]
  : [];
---

<Base baslik="Hakkımda" aciklama="Göktürk Fulser kimdir, bu site ne için var.">
  <section class="bant bant--koyu bant--basi" aria-labelledby="hakkimda-baslik">
    <div class="kap">
      <h1 id="hakkimda-baslik" class="h1">Hakkımda</h1>
    </div>
  </section>
  <section class="bant bant--acik" data-pagefind-body>
    <div class="kap kolon">
      <div class="metin">
        {
          SHOW_DRAFTS ? (
            <>
              <p>
                Ben Göktürk. Yazılım geliştiriyorum; boş zamanlarımda film izliyor, basketbol maçlarını
                takip ediyor ve küçük projeler yapıyorum.
              </p>
              <p>
                Bu site film yazılarımı, basketbol notlarımı ve projelerimi bir araya getirdiğim kişisel
                alanım. İçerikler Türkçe.
              </p>
            </>
          ) : (
            <p>Bu sayfa hazırlanıyor. Yazılar ve projeler için üstteki menüyü kullanabilirsiniz.</p>
          )
        }
      </div>
      <DeneyimZamanCizelgesi ogeler={deneyim} />
    </div>
  </section>
</Base>

<style>
  .kolon {
    max-width: 62rem;
    margin-inline: auto;
  }
</style>
