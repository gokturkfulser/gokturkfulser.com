---
// /hakkimda/: "önce hikâye, sonra özgeçmiş". Koyu kapak (büyük cümle + birinci tekil şahıs metin; src/content/hakkimda.<dil>.md),
// kâğıt bandında "Yol" zaman çizelgesi, koyu bantta sayılar ve "Şu sıralar", kâğıtta "Araç kutusu" ve varsayılan kapalı <details> içinde özgeçmişin tamamı.
// Veri: src/content/ozgecmis.yaml (Zod şemalı, { en, tr } iki dilli). i18n gelene kadar `tr` gösterilir (`dil`); bileşen `en`'i şimdiden destekler.
// Boş olan bölüm hiç render edilmez. Yazdırmada yalnızca <details> içindeki özgeçmiş basılır (A4, açık); diğer bantlar gizlidir.
// `taslak: true` iken production'da "hazırlanıyor" durumu gösterilir (nav bağlantısı kalır); SHOW_DRAFTS=true'da sayfa görünür.
import { getEntry, render } from 'astro:content';
import { LETTERBOXD_RSS, SHOW_DRAFTS } from 'astro:env/server';
import Base from '../layouts/Base.astro';
import SayilarSeridi from '../components/SayilarSeridi.astro';
import SonIzlenenlerKucuk from '../components/SonIzlenenlerKucuk.astro';
import { projeler, tumYazilar } from '../lib/content';
import { donemYaz, yerel, yilAraligi, type Dil } from '../lib/format';
import { sonIzlenenler } from '../lib/letterboxd';

const dil: Dil = 'tr';
const kayit = await getEntry('ozgecmis', 'ozgecmis');
const cv = kayit && (SHOW_DRAFTS || !kayit.data.taslak) ? kayit.data : undefined;

// Kapak metni: dile göre dosya, yoksa `tr`. Başlık ya da gövde boşsa kapak bandı yoktur.
const hikayeKaydi = (await getEntry('hakkimda', dil)) ?? (await getEntry('hakkimda', 'tr'));
const hikayeVar = Boolean(hikayeKaydi?.data.baslik && hikayeKaydi.body?.trim());
const Hikaye = hikayeKaydi && hikayeVar ? (await render(hikayeKaydi)).Content : undefined;

const [tumProjeler, yazilar, izlenenler] = cv
  ? await Promise.all([projeler(), tumYazilar(), sonIzlenenler(LETTERBOXD_RSS, 6)])
  : [[], [], []];
const proje = (slug: string) => tumProjeler.find((p) => p.id === slug);
// Özgeçmişteki proje listesi: yalnızca görünür (taslak olmayan) projeler.
const cvProjeleri = (cv?.projeler ?? []).flatMap(({ slug }) => proje(slug) ?? []);

const ozet = cv?.ozet ? yerel(cv.ozet, dil) : '';
const konum = cv?.kimlik.konum ? yerel(cv.kimlik.konum, dil) : '';
const iletisim = cv
  ? [
      ...(cv.kimlik.eposta ? [{ ad: 'E-posta', href: `mailto:${cv.kimlik.eposta}`, metin: cv.kimlik.eposta }] : []),
      ...cv.kimlik.baglantilar.map((b) => ({
        ad: b.ad,
        href: b.url,
        metin: b.url.replace(/^https?:\/\//, '').replace(/\/$/, ''),
      })),
    ]
  : [];

// "Yol": deneyim, eğitim ve ek duraklar; `kisa` cümlesi olanlar, başlangıca göre sıralı.
const anahtar = (t: string) => (t.length === 4 ? `${t}-00` : t);
const duraklar = cv
  ? [
      ...cv.deneyim.flatMap((d) =>
        d.roller.flatMap((r) =>
          r.kisa ? { baslangic: r.baslangic, bitis: r.bitis, kurum: d.kurum, href: d.web || undefined, kisa: yerel(r.kisa, dil) } : [],
        ),
      ),
      ...cv.egitim.flatMap((e) =>
        e.kisa ? { baslangic: e.baslangic, bitis: e.bitis, kurum: yerel(e.kurum, dil), href: e.web || undefined, kisa: yerel(e.kisa, dil) } : [],
      ),
      ...cv.duraklar.map((d) => ({ baslangic: d.baslangic, bitis: d.bitis, kurum: yerel(d.kurum, dil), href: d.href, kisa: yerel(d.kisa, dil) })),
    ].sort((a, b) => anahtar(a.baslangic).localeCompare(anahtar(b.baslangic)))
  : [];

// Büyük sayılar: yayındaki proje ve yazı sayısı otomatik; elle girilenler yaml'da. Sıfır/boş olan gösterilmez; tek sayı şerit olmaz.
const sayilar = (
  cv
    ? [
        { deger: tumProjeler.filter((p) => p.data.durum === 'yayinda').length, etiket: 'yayındaki proje' },
        { deger: yazilar.length, etiket: 'yazı' },
        ...cv.sayilar.map((s) => ({ deger: s.deger, etiket: yerel(s.etiket, dil), not: s.not ? yerel(s.not, dil) : undefined })),
      ]
    : []
).filter((s) => (typeof s.deger === 'number' ? s.deger > 0 : s.deger.length > 0));

// "Şu sıralar": boş grup yok; izlediklerim Letterboxd'dan.
const suSiralar = (cv?.su_siralar ?? []).filter((g) => g.ogeler.length > 0);
const suSiralarVar = suSiralar.length > 0 || izlenenler.length > 0;

const arac = cv?.beceriler.filter((b) => b.cumle) ?? [];
const ARAC_ETIKET = 6;
---

<Base baslik="Hakkımda" aciklama="Göktürk Fulser kimdir: hikâye ve özgeçmiş." bindirme={Boolean(cv && Hikaye)}>
  {
    cv ? (
      <div data-pagefind-body>
        {Hikaye ? (
          <section class="bant bant--koyu kapak yazdirma-gizle" aria-labelledby="hakkimda-baslik">
            <div class="kap kapak-ic">
              <p class="kunye">
                <span>{cv.kimlik.ad}</span>
                <span>{yerel(cv.kimlik.unvan, dil)}{konum && <>, {konum}</>}</span>
              </p>
              <h1 id="hakkimda-baslik" class="kapak-baslik">
                <span class="satir"><span>{hikayeKaydi!.data.baslik}</span></span>
              </h1>
              <div class="hikaye">
                <Hikaye />
              </div>
            </div>
          </section>
        ) : (
          <section class="bant bant--acik bant--basi yazdirma-gizle" aria-labelledby="hakkimda-baslik">
            <div class="kap">
              <h1 id="hakkimda-baslik" class="h1"><span class="satir"><span>Hakkımda</span></span></h1>
            </div>
          </section>
        )}

        {
          duraklar.length > 1 && (
            <section class="bant bant--acik yazdirma-gizle" aria-labelledby="yol-baslik">
              <div class="kap">
                <h2 id="yol-baslik" class="bolum-baslik">Yol</h2>
                <ol class="lista yol">
                  {duraklar.map((d) => (
                    <li class="durak">
                      <p class="yil">{yilAraligi(d.baslangic, d.bitis)}</p>
                      <p class="yer">{d.href ? <a href={d.href}>{d.kurum}</a> : d.kurum}</p>
                      <p class="cumle">{d.kisa}</p>
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          )
        }

        {sayilar.length >= 2 && <div class="yazdirma-gizle"><SayilarSeridi {sayilar} ton="koyu" etiket="Sayılarla" /></div>}

        {
          suSiralarVar && (
            <section class="bant bant--koyu su-bandi yazdirma-gizle" aria-labelledby="su-siralar-baslik">
              <div class="kap">
                <h2 id="su-siralar-baslik" class="bolum-baslik">Şu sıralar</h2>
                <div class="su-siralar">
                  {suSiralar.map((g) => (
                    <div class="su-grup">
                      <h3 class="alt-baslik">{yerel(g.baslik, dil)}</h3>
                      <ul class="lista">
                        {g.ogeler.map((o) => {
                          const p = o.slug ? proje(o.slug) : undefined;
                          return <li>{p ? <a href={`/projeler/${p.id}/`}>{yerel(o.metin, dil)}</a> : yerel(o.metin, dil)}</li>;
                        })}
                      </ul>
                    </div>
                  ))}
                  <SonIzlenenlerKucuk filmler={izlenenler} baslik="İzlediğim" />
                </div>
              </div>
            </section>
          )
        }

        <section class="bant bant--acik" aria-labelledby={arac.length > 0 ? 'arac-baslik' : 'tam-baslik'}>
          <div class="kap">
            {
              arac.length > 0 && (
                <div class="arac-kutusu yazdirma-gizle">
                  <h2 id="arac-baslik" class="bolum-baslik">Araç kutusu</h2>
                  <div class="arac">
                    {arac.map((b) => (
                      <div class="arac-grup">
                        <h3>{yerel(b.grup, dil)}</h3>
                        <p class="cumle">{yerel(b.cumle!, dil)}</p>
                        <ul class="lista sakin-etiketler" aria-label={`${yerel(b.grup, dil)} araçları`}>
                          {b.ogeler.slice(0, ARAC_ETIKET).map((o) => <li>{o}</li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }

            <div class="tam">
              <div class="tam-bas yazdirma-gizle">
                <h2 id="tam-baslik" class="bolum-baslik">Özgeçmişin tamamı</h2>
                <p><button type="button" class="baglanti-dugme" data-yazdir>Özgeçmişi PDF olarak indir</button></p>
              </div>

              <details class="ozgecmis">
                <summary class="yazdirma-gizle">Deneyim, projeler, eğitim, beceriler ve iletişim ayrıntıları</summary>
                <div class="cv-ic">
                  <header class="cv-yazdir">
                    <p class="cv-ad">{cv.kimlik.ad}</p>
                    <p class="cv-unvan">{yerel(cv.kimlik.unvan, dil)}{konum && <>, {konum}</>}</p>
                    {ozet && <p class="cv-ozet">{ozet}</p>}
                  </header>

                  {
                    cv.deneyim.length > 0 && (
                      <section aria-labelledby="deneyim-baslik">
                        <h3 id="deneyim-baslik" class="cv-baslik">Deneyim</h3>
                        {cv.deneyim.map((d) => (
                          <div class="kurum">
                            <h4>{d.web ? <a href={d.web}>{d.kurum}</a> : d.kurum}</h4>
                            {d.konum && <p class="soluk kurum-konum">{d.konum}</p>}
                            {d.roller.map((r) => (
                              <div class="kayit">
                                <p class="donem">{donemYaz(r.baslangic, r.bitis, dil)}</p>
                                <div>
                                  <h5>{yerel(r.unvan, dil)}</h5>
                                  {r.not && <p class="soluk rol-not">{yerel(r.not, dil)}</p>}
                                  {r.maddeler.length > 0 && <ul>{r.maddeler.map((m) => <li>{yerel(m, dil)}</li>)}</ul>}
                                </div>
                              </div>
                            ))}
                          </div>
                        ))}
                      </section>
                    )
                  }
                  {
                    cvProjeleri.length > 0 && (
                      <section aria-labelledby="proje-baslik">
                        <h3 id="proje-baslik" class="cv-baslik">Projeler</h3>
                        <ul class="lista projeler">
                          {cvProjeleri.map((p) => (
                            <li>
                              <a href={`/projeler/${p.id}/`}>{p.data.ad}</a>
                              <span class="yazdir-url"> ({new URL(`/projeler/${p.id}/`, Astro.site).href})</span>
                              <span class="soluk"> — {p.data.ozet}</span>
                            </li>
                          ))}
                        </ul>
                      </section>
                    )
                  }
                  {
                    cv.egitim.length > 0 && (
                      <section aria-labelledby="egitim-baslik">
                        <h3 id="egitim-baslik" class="cv-baslik">Eğitim</h3>
                        {cv.egitim.map((e) => (
                          <div class="kayit">
                            <p class="donem">{donemYaz(e.baslangic, e.bitis, dil)}</p>
                            <div>
                              <h5>{yerel(e.derece, dil)}</h5>
                              <p class="soluk">
                                {e.web ? <a href={e.web}>{yerel(e.kurum, dil)}</a> : yerel(e.kurum, dil)}
                                {e.konum && <>, {e.konum}</>}
                              </p>
                            </div>
                          </div>
                        ))}
                      </section>
                    )
                  }
                  {
                    cv.beceriler.length > 0 && (
                      <section class="yeni-sayfa" aria-labelledby="beceri-baslik">
                        <h3 id="beceri-baslik" class="cv-baslik">Beceriler</h3>
                        <dl class="ikili">
                          {cv.beceriler.map((b) => (
                            <>
                              <dt>{yerel(b.grup, dil)}</dt>
                              <dd>{b.ogeler.join(', ')}</dd>
                            </>
                          ))}
                        </dl>
                      </section>
                    )
                  }
                  {
                    cv.diller.length > 0 && (
                      <section aria-labelledby="dil-baslik">
                        <h3 id="dil-baslik" class="cv-baslik">Diller</h3>
                        <dl class="ikili">
                          {cv.diller.map((d) => (
                            <>
                              <dt>{yerel(d.ad, dil)}</dt>
                              <dd>{yerel(d.seviye, dil)}</dd>
                            </>
                          ))}
                        </dl>
                      </section>
                    )
                  }
                  {
                    iletisim.length > 0 && (
                      <section aria-labelledby="iletisim-baslik">
                        <h3 id="iletisim-baslik" class="cv-baslik">İletişim</h3>
                        <dl class="ikili">
                          {iletisim.map((i) => (
                            <>
                              <dt>{i.ad}</dt>
                              <dd><a href={i.href}>{i.metin}</a></dd>
                            </>
                          ))}
                        </dl>
                      </section>
                    )
                  }
                </div>
              </details>
            </div>
          </div>
        </section>
      </div>
    ) : (
      <section class="bant bant--acik bant--basi" aria-labelledby="hakkimda-baslik">
        <div class="kap hazirlaniyor">
          <h1 id="hakkimda-baslik" class="h1"><span class="satir"><span>Hakkımda</span></span></h1>
          <p class="lede">Bu sayfa hazırlanıyor. Yazılar ve projeler için üstteki menüyü kullanabilirsiniz.</p>
        </div>
      </section>
    )
  }
</Base>

{
  cv && (
    <script>
      // Paketlenmiş (hash'li) betik: CSP 'unsafe-inline' gerektirmez; yalnızca bu sayfaya girer.
      document.querySelector('[data-yazdir]')?.addEventListener('click', () => window.print());
      // Kapalı <details> içeriğini basmayan eski tarayıcılar için: yazdırma sırasında açılır, sonra eski durumuna döner.
      const ozgecmis = document.querySelector<HTMLDetailsElement>('details.ozgecmis');
      let acikmiydi = false;
      addEventListener('beforeprint', () => {
        if (ozgecmis) {
          acikmiydi = ozgecmis.open;
          ozgecmis.open = true;
        }
      });
      addEventListener('afterprint', () => {
        if (ozgecmis) ozgecmis.open = acikmiydi;
      });
    </script>
  )
}

<style>
  /* ——— Koyu kapak ——— */
  .kapak {
    padding-block: clamp(8rem, 18vw, 13rem) var(--bant);
  }

  .kapak-ic {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: clamp(1.5rem, 3vw, 2.6rem) clamp(2rem, 5vw, 6rem);
  }

  .kunye {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem clamp(1rem, 3vw, 2.5rem);
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    font-weight: 500;
    color: var(--soluk);
  }

  .kunye span:first-child {
    color: var(--murekkep);
    font-weight: 600;
  }

  .kapak-baslik {
    grid-column: 1 / -1;
    max-width: 20ch;
    font-size: clamp(2.75rem, 1rem + 6.4vw, 7rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hikaye {
    grid-column: 2;
    display: grid;
    gap: 1.2em;
    font-family: var(--font-bas);
    font-size: var(--yazi-lede);
    line-height: 1.38;
    letter-spacing: -0.005em;
    color: var(--lede-renk);
  }

  .hikaye :global(p) {
    margin: 0;
    text-wrap: pretty;
  }

  /* ——— Bölüm başlığı (kâğıtta Hanken, koyuda Cormorant; her ikisi ≥ 24 px) ——— */
  .bolum-baslik {
    margin-block-end: clamp(1.75rem, 3.5vw, 3rem);
    font-size: clamp(2.25rem, 1rem + 3.6vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .alt-baslik {
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--soluk);
  }

  .cumle {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  /* ——— Yol: yatay zaman çizelgesi (mobilde dikey) ——— */
  .yol {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(12rem, 1fr);
    gap: 0 clamp(1.5rem, 3vw, 3rem);
    padding-block-start: 6px;
    overflow-x: auto;
  }

  .durak {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-block-start: 1.4rem;
    border-block-start: 1px solid var(--murekkep);
  }

  .durak::before {
    content: '';
    position: absolute;
    inset: -5px auto auto 0;
    width: 9px;
    height: 9px;
    background: var(--vurgu);
  }

  .durak p {
    margin: 0;
  }

  .yil {
    font-family: var(--font-baslik-yigin);
    font-size: clamp(1.5rem, 1rem + 1.3vw, 2.125rem);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .yer {
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 600;
  }

  /* ——— Şu sıralar ——— */
  /* Sayılar bandının hemen altında: çift bant boşluğu olmasın */
  .su-bandi {
    padding-block-start: calc(var(--bant) * 0.6);
  }

  .su-siralar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .su-grup {
    display: grid;
    gap: var(--aralik-3);
  }

  .su-grup li {
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .su-grup li + li {
    margin-block-start: 0.5rem;
  }

  /* ——— Araç kutusu ——— */
  .arac-kutusu {
    margin-block-end: clamp(3rem, 6vw, 6rem);
  }

  .arac {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 4rem);
  }

  .arac-grup {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .arac-grup h3 {
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .sakin-etiketler {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.4rem;
  }

  .sakin-etiketler li {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--cizgi);
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  /* ——— Özgeçmişin tamamı ——— */
  .tam-bas {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--aralik-3) var(--aralik-5);
  }

  .tam-bas .bolum-baslik {
    margin-block-end: 0;
  }

  .tam-bas p {
    margin: 0;
  }

  /* Sakin bağlantı görünümlü düğme: tek stil, bağlantı gibi altı çizili */
  .baglanti-dugme {
    padding: 0.4rem 0;
    border: 0;
    background: transparent;
    color: var(--murekkep);
    font: inherit;
    font-family: var(--font-baslik-yigin);
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--vurgu);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .baglanti-dugme:hover {
    text-decoration-color: var(--murekkep);
  }

  .ozgecmis {
    margin-block-start: clamp(1.25rem, 2.5vw, 2rem);
    border-block: 1px solid var(--murekkep);
  }

  .ozgecmis summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--aralik-3);
    padding-block: 1rem;
    font-family: var(--font-baslik-yigin);
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .ozgecmis summary::-webkit-details-marker {
    display: none;
  }

  .ozgecmis summary::after {
    content: '+';
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
  }

  .ozgecmis[open] summary::after {
    content: '–';
  }

  .cv-ic {
    max-width: 62rem;
    padding-block: 0.5rem 2rem;
  }

  .cv-yazdir {
    display: none;
  }

  .cv-ic section {
    padding-block-start: 2rem;
  }

  .cv-baslik {
    margin-block-end: 1rem;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .kurum + .kurum {
    margin-block-start: 1.6rem;
  }

  .kurum h4 {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .kurum-konum {
    margin: 0 0 0.6rem;
  }

  .rol-not {
    font-size: var(--yazi-xs);
    line-height: 1.4;
  }

  .projeler li + li {
    margin-block-start: 0.5rem;
  }

