---
import SinemaYazisi from '../../components/yazi/SinemaYazisi.astro';
import BasketbolYazisi from '../../components/yazi/BasketbolYazisi.astro';
import { basketbolCevirisi, cevirilenYaziUrl, tumYazilar } from '../../lib/content';

export async function getStaticPaths() {
  return (await tumYazilar()).map((yazi) => ({
    params: { slug: yazi.entry.id },
    props: { yazi },
  }));
}

const { yazi } = Astro.props;
// Basketbol yazısının İngilizce çevirisi varsa dil geçişi ve hreflang bağlanır.
const ceviri = yazi.bolum === 'basketbol' ? await basketbolCevirisi(yazi.entry.id) : undefined;
---

{
  yazi.bolum === 'sinema' ? (
    <SinemaYazisi entry={yazi.entry} />
  ) : (
    <BasketbolYazisi entry={yazi.entry} diger={ceviri && { dil: 'en', href: cevirilenYaziUrl(ceviri.id) }} />
  )
}
