---
import { Image } from 'astro:assets';
import Medya from '../../components/Medya.astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoVideo from '../../components/DemoVideo.astro';
import OyunKutusu from '../../components/OyunKutusu.astro';
import { mdxBilesenleri } from '../../components/mdx';
import { projeler } from '../../lib/content';
import { BARINDIRMA, DURUM, STORE, TUR } from '../../lib/labels';

export async function getStaticPaths() {
  return (await projeler()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const yakinda = data.durum === 'yakinda';
const arsiv = data.durum === 'arsiv';
const vps = data.barindirma === 'vps';

// Yakında olan projede canlı bağlantı, mağaza bağlantısı ve gömülü oyun gösterilmez.
const storeLinkleri = yakinda
  ? []
  : Object.entries(data.storeLinkleri ?? {}).filter(
      (cift): cift is [string, string] => typeof cift[1] === 'string',
    );
const canliUrl = yakinda ? undefined : data.url;
const oynat = !yakinda && data.embedUrl;
// Yakında + demo videosu: video kapak görselinin yerine öne çıkar.
const videoOnde = yakinda && data.demoVideo;
---

<Base baslik={data.ad} aciklama={data.ozet}>
  <article data-dunya="proje" data-pagefind-body>
    <header class="bant bant--koyu bant--basi">
      <div class="kap ust">
        <div class="ust-metin">
          <h1 class="h1">{data.ad}</h1>
          <p class="lede">{data.ozet}</p>
          {
            yakinda && (
              <p class="not yakinda" role="note">
                <strong>Yakında.</strong> Henüz yayında değil.
                {vps && ' Servis yayına alındığında kendi adresinde, VPS üzerinde çalışacak.'}
              </p>
            )
          }
          {arsiv && <p class="not" role="note"><strong>Arşiv.</strong> Artık geliştirilmiyor.</p>}
          <dl class="bilgi">
            <div>
              <dt>Tür</dt>
              <dd>{TUR[data.tur]}</dd>
            </div>
            <div>
              <dt>Durum</dt>
              <dd>{DURUM[data.durum]}</dd>
            </div>
            <div>
              <dt>Barındırma</dt>
              <dd>{BARINDIRMA[data.barindirma]}</dd>
            </div>
          </dl>
          <ul class="lista baglantilar">
            {canliUrl && <li><a href={canliUrl}>Projeyi aç</a></li>}
            {data.repo && <li><a href={data.repo}>Kaynak kod</a></li>}
            {data.demoVideo && !videoOnde && <li><a href="#demo">Demo videosu</a></li>}
            {storeLinkleri.map(([anahtar, href]) => <li><a href={href}>{STORE[anahtar]}</a></li>)}
          </ul>
        </div>
        {
          videoOnde ? (
            <div class="medya-kutu" id="demo">
              <DemoVideo url={data.demoVideo!} baslik={data.ad} poster={data.gorsel} />
            </div>
          ) : (
            <Medya class="medya-kutu" src={data.gorsel} oran="proje" width={1200} oncelikli />
          )
        }
      </div>
    </header>

    <div class="bant bant--acik govde">
      <div class="kap sayfa">
        {
          oynat && (
            <section class="oyun-bolumu" aria-labelledby="oyun-baslik">
              <h2 id="oyun-baslik" class="h3">{data.tur === 'oyun' ? 'Burada oyna' : 'Burada dene'}</h2>
              <OyunKutusu
                baslik={data.ad}
                kapak={data.gorsel}
                embedUrl={data.embedUrl!}
                etiket={data.tur === 'oyun' ? 'Oyna' : 'Dene'}
              />
            </section>
          )
        }

        {
          data.demoVideo && !videoOnde && (
            <section id="demo" aria-labelledby="demo-baslik">
              <h2 id="demo-baslik" class="h3">Demo videosu</h2>
              <DemoVideo url={data.demoVideo} baslik={data.ad} poster={data.gorsel} />
            </section>
          )
        }

        <div class="metin">
          <Content components={mdxBilesenleri} />
        </div>

        {
          data.ekranGoruntuleri.length > 0 && (
            <section aria-labelledby="ekran-baslik">
              <h2 id="ekran-baslik" class="h3">Ekran görüntüleri</h2>
              <ul class="lista ekranlar">
                {data.ekranGoruntuleri.map((e) => (
                  <li>
                    <figure>
                      <Image src={e.gorsel} alt={e.alt} width={900} loading="lazy" />
                      {e.altyazi && <figcaption>{e.altyazi}</figcaption>}
                    </figure>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.stack.length > 0 && (
            <section aria-labelledby="stack-baslik">
              <h2 id="stack-baslik" class="h3">Kullanılan teknolojiler</h2>
              <ul class="lista teknolojiler">{data.stack.map((s) => <li>{s}</li>)}</ul>
            </section>
          )
        }
      </div>
    </div>
  </article>
</Base>

<style>
  .ust {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: end;
  }

  .ust-metin {
    display: grid;
    gap: var(--aralik-4);
  }

  h1 {
    letter-spacing: -0.055em;
  }

  .not {
    max-width: 44ch;
    margin: 0;
    padding-inline-start: var(--aralik-3);
    border-inline-start: 6px solid var(--murekkep);
    font-family: var(--font-baslik-yigin);
    line-height: 1.5;
  }

  .not.yakinda {
    border-inline-start-color: var(--turuncu-metin);
  }

  .bilgi {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-2) var(--aralik-5);
    margin: 0;
    font-family: var(--font-baslik-yigin);
  }

  .bilgi dt {
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  .bilgi dd {
    margin: 0;
    font-weight: 600;
  }

  .baglantilar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-2) var(--aralik-4);
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .sayfa {
    display: grid;
    gap: var(--aralik-6);
  }

  .sayfa h2 {
    margin-block-end: var(--aralik-3);
  }

  .govde :global(.metin) {
    max-width: 46rem;
  }

  .ekranlar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-4);
    align-items: flex-start;
  }

  .ekranlar li {
    flex: 1 1 20rem;
    max-width: 36rem;
  }

  .ekranlar figure {
    margin: 0;
  }

  .ekranlar img {
    width: 100%;
    height: auto;
    border-radius: var(--medya-kose);
  }

  .ekranlar figcaption {
    margin-block-start: var(--aralik-2);
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    color: var(--soluk);
  }

  .teknolojiler {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-2) var(--aralik-4);
    font-family: var(--font-baslik-yigin);
    font-weight: 500;
  }

  @media (max-width: 52rem) {
    .ust {
      grid-template-columns: 1fr;
    }

    .ust :global(.medya-kutu) {
      order: -1;
    }
  }
</style>
