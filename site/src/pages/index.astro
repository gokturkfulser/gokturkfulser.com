---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import YaziKarti from '../components/YaziKarti.astro';
import YaziSahnesi from '../components/YaziSahnesi.astro';
import ProjeVitrin from '../components/ProjeVitrin.astro';
import SayilarSeridi from '../components/SayilarSeridi.astro';
import SonIzlenenler from '../components/SonIzlenenler.astro';
import { LETTERBOXD_RSS } from 'astro:env/server';
import { oneCikanYazilar, projeler, tumYazilar } from '../lib/content';
import { sonIzlenenler } from '../lib/letterboxd';
import { HERO_CUMLESI, KISACA_METNI } from '../lib/site';

const [vitrinYazilar, yazilar, tumProjeler] = await Promise.all([oneCikanYazilar(3), tumYazilar(), projeler()]);
const [buyukYazi, ...digerYazilar] = vitrinYazilar;
// LETTERBOXD_RSS tanımlı değilse boş döner ve şerit hiç render edilmez.
const izlenenler = await sonIzlenenler(LETTERBOXD_RSS);

const vitrinProjeler = (() => {
  const aktif = tumProjeler.filter((p) => p.data.durum !== 'arsiv');
  const secili = aktif.filter((p) => p.data.oneCikan);
  return (secili.length > 0 ? secili : aktif).slice(0, 4);
})();

const sayilar = [
  { deger: yazilar.length, etiket: 'yazı' },
  { deger: tumProjeler.length, etiket: 'proje' },
].filter((s) => s.deger > 0); // sıfır sayı gösterilmez
// Tek başına kalan bir sayı şerit olmaz: en az iki sayı varsa çizilir.
const sayiSeridiVar = sayilar.length >= 2;
---

<Base bindirme>
  <Hero cumle={HERO_CUMLESI || undefined} yazi={buyukYazi} proje={vitrinProjeler[0]} />

  {vitrinProjeler.length > 0 && <ProjeVitrin projeler={vitrinProjeler} ton="koyu" />}

  {
    buyukYazi && (
      <section class="yazilar" aria-labelledby="yazilar-baslik">
        <div class="kap bas-bandi">
          <div class="bas-satiri">
            <h2 id="yazilar-baslik" class="h2">Yazılar</h2>
            <a href="/yazilar/">Tüm yazılar</a>
          </div>
        </div>
        <YaziSahnesi yazi={buyukYazi} />
        {digerYazilar.length > 0 && (
          <div class="kap yan-yazilar">
            {digerYazilar.map((y) => (
              <YaziKarti yazi={y} />
            ))}
          </div>
        )}
      </section>
    )
  }

  {
    KISACA_METNI && (
      <section class="bant bant--koyu" aria-labelledby="kisaca-baslik">
        <div class="kap kisaca">
          <h2 id="kisaca-baslik" class="h3">Kısaca</h2>
          <div>
            <p class="kisaca-metin">{KISACA_METNI}</p>
            <p class="kisaca-link"><a href="/hakkimda/">Hakkımda</a></p>
          </div>
        </div>
      </section>
    )
  }

  {sayiSeridiVar && <SayilarSeridi {sayilar} ton="koyu" />}

  <SonIzlenenler filmler={izlenenler} ton="koyu" />
</Base>

<style>
  .yazilar {
    background: var(--perde);
    padding-block-start: var(--bant);
  }

  .bas-bandi .bas-satiri {
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  .yan-yazilar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block-start: clamp(2rem, 4vw, 3.5rem);
  }

  .kisaca {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: var(--aralik-4) clamp(2rem, 5vw, 6rem);
  }

  .kisaca-metin {
    font-family: var(--font-serif-yigin);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .kisaca-link {
    margin: var(--aralik-5) 0 0;
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 600;
  }

  @media (max-width: 52rem) {
    .kisaca {
      grid-template-columns: 1fr;
    }
  }
</style>
