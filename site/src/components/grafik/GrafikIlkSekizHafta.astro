---
// "İlk 8 haftada kaybedilen maç": sütun grafiği. Veri: src/data/nba-sakatlik.json > first8Weeks.
// Değeri olmayan (gamesLost: null) sezon içi boş, kesikli çerçeveli sütun + not olarak çizilir.
import GrafikKutu from './GrafikKutu.astro';
import veri from '../../data/nba-sakatlik.json';
import type { Dil } from '../../lib/format';
import { sayiYaz } from '../../lib/grafik';

interface Props {
  dil?: Dil;
}
const { dil = 'tr' } = Astro.props;
const en = dil === 'en';

const t = en
  ? {
      baslik: 'Games lost in the first 8 weeks',
      ozet: 'Games lost to injury or illness in the first 8 weeks of the season',
      kaynak: 'Source: Jeff Stotts’s data via Front Office Sports (see',
      kaynakBag: 'Sources',
      kaynakSon: '). The dashed slot marks a season that has not reached week 8 yet.',
      bekleniyor: 'not known yet',
      yuvaNotu: 'end of November',
    }
  : {
      baslik: 'İlk 8 haftada kaybedilen maç',
      ozet: 'Sezonun ilk 8 haftasında sakatlık ve hastalık yüzünden kaçırılan maç',
      kaynak: 'Kaynak: Jeff Stotts verisi, Front Office Sports aracılığıyla (bkz.',
      kaynakBag: 'Kaynaklar',
      kaynakSon: '). Kesikli yuva, 8. haftaya henüz gelmemiş sezonu gösterir.',
      bekleniyor: 'henüz belli değil',
      yuvaNotu: 'kasım sonu',
    };

const W = 400;
const H = 284;
const TABAN = 222;
const UST = 36;
const MAX = 2200; // eksen üst sınırı
const SUTUN = 72;
const ARALIK = (W - 8 - veri.first8Weeks.length * SUTUN) / (veri.first8Weeks.length - 1);
const yukseklik = (v: number) => (v / MAX) * (TABAN - UST);
const YUVA = 26; // değeri olmayan sezonun boş yuvası: sabit, düşük; ölçeğe (MAX) bağlı değildir

const sutunlar = veri.first8Weeks.map((s, i) => {
  const x = 4 + i * (SUTUN + ARALIK);
  const bos = s.gamesLost == null;
  const h = bos ? YUVA : yukseklik(s.gamesLost as number);
  const not = 'note' in s ? (en ? s.noteEn : s.note) : undefined;
  return { s, x, bos, h, y: TABAN - h, orta: x + SUTUN / 2, not };
});

const ariaEtiketi = `${t.baslik}. ${t.ozet}: ${sutunlar
  .map((c) => `${c.s.season}: ${c.bos ? `${t.bekleniyor}${c.not ? ` (${c.not})` : ''}` : sayiYaz(c.s.gamesLost as number, dil)}`)
  .join('; ')}.`;
---

<GrafikKutu id="g-ilk8" baslik={t.baslik}>
  <svg class="svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaEtiketi}>
    <title>{t.baslik}</title>
    <line class="taban" x1="0" x2={W} y1={TABAN} y2={TABAN} aria-hidden="true"></line>
    {
      sutunlar.map((c) =>
        c.bos ? (
          <g>
            <rect class="bos" x={c.x + 0.75} y={c.y} width={SUTUN - 1.5} height={c.h} rx="2" />
            <text class="not" x={c.x + SUTUN} y={TABAN + 42} text-anchor="end">{t.yuvaNotu}</text>
          </g>
        ) : (
          <g>
            <rect class="sutun" x={c.x} y={c.y} width={SUTUN} height={c.h} />
            <text class="deger" x={c.orta} y={c.y - 8} text-anchor="middle">{sayiYaz(c.s.gamesLost as number, dil)}</text>
          </g>
        ),
      )
    }
    {
      sutunlar.map((c) => (
        <text class="sezon" x={c.orta} y={TABAN + 22} text-anchor="middle">{c.s.season}</text>
      ))
    }
  </svg>
  <Fragment slot="kaynak">{t.kaynak}{' '}<a href={en ? '#sources' : '#kaynaklar'}>{t.kaynakBag}</a>{t.kaynakSon}</Fragment>
</GrafikKutu>

<style>
  .svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    overflow: visible;
    font-family: var(--font-baslik-yigin);
  }

  /* Taban çizgisi anlam taşır: koyu bantta --cizgi (1,6:1) yetmez, --soluk kullanılır */
  .taban {
    stroke: var(--soluk);
    stroke-width: 1.5;
  }

  .sutun {
    fill: var(--dunya-metin);
  }

  .bos {
    fill: none;
    stroke: var(--dunya-metin);
    stroke-width: 2;
    stroke-dasharray: 7 5;
  }

  .deger {
    font-size: 16px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    fill: var(--murekkep);
  }

  .sezon {
    font-size: 13px;
    fill: var(--soluk);
  }

  .not {
    font-size: 14px;
    font-weight: 600;
    fill: var(--murekkep);
  }
</style>
