---
import YaziKapagi from './YaziKapagi.astro';
import { yaziUrl, type Yazi } from '../lib/content';
import { tarihIso, tarihYaz } from '../lib/format';
import { dilAl, sozluk } from '../i18n';

interface Props {
  yazi: Yazi;
  /** `buyuk`: kapak 2,39:1, başlık dev; `orta`: kapak 16:10. */
  boyut?: 'buyuk' | 'orta';
  oncelikli?: boolean;
}

const { yazi, boyut = 'orta', oncelikli = false } = Astro.props;
const { data } = yazi.entry;
const dil = dilAl(Astro);
const s = sozluk(dil);
const href = yaziUrl(yazi);
// Sayfanın dilinde olmayan yazı küçük bir dil etiketiyle işaretlenir ve kendi adresine bağlanır.
const yabanci = data.dil !== dil;
---

<article class:list={['kart', boyut]} data-dunya={yazi.bolum}>
  <a class="kapak" href={href} tabindex="-1" aria-hidden="true">
    <YaziKapagi
      {yazi}
      oran={boyut === 'buyuk' ? 'kapak' : 'vitrin'}
      width={boyut === 'buyuk' ? 1400 : 800}
      {oncelikli}
      class="ac"
    />
  </a>
  <p class="bolum">
    <span class="bolum-adi">{s.bolum[yazi.bolum]}</span>
    <time datetime={tarihIso(data.tarih)}>{tarihYaz(data.tarih, dil)}</time>
    {yabanci && <span class="dil-etiketi">{s.yaziDili[data.dil]}</span>}
  </p>
  <h3><a href={href} lang={yabanci ? data.dil : undefined} hreflang={yabanci ? data.dil : undefined}>{data.baslik}</a></h3>
  <p class="ozet" lang={yabanci ? data.dil : undefined}>{data.ozet}</p>
</article>

<style>
  .kart {
    display: grid;
    gap: var(--aralik-2);
    align-content: start;
  }

  .kapak {
    display: block;
    margin-block-end: var(--aralik-2);
    text-decoration: none;
  }

  .bolum {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--aralik-3);
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    font-weight: 500;
    color: var(--soluk);
  }

  .bolum-adi {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
    color: var(--murekkep);
  }

  .bolum-adi::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--dunya-bant);
  }

  h3 {
    font-size: var(--yazi-h3);
  }

  .buyuk h3 {
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.5rem);
    line-height: 0.95;
  }

  .ozet {
    max-width: 48ch;
    margin: 0;
    color: var(--soluk);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
</style>
