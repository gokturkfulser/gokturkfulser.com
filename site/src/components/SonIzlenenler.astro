---
// Son izlediklerim: yavaş akan afiş bandı (saf CSS; içerik iki kez, ikincisi aria-hidden + inert).
// WCAG 2.2.2 (Duraklat, durdur, gizle): hover/klavye odağında durur ve yanında görünür bir "Akışı durdur / Akışı oynat"
// düğmesi vardır. Düğme JS'siz: klavyeyle odaklanabilen onay kutusu (sabit aria-label; işaretli = durdurulmuş) + görsel etiket; `:checked ~ .akis` ile animation-play-state: paused.
// prefers-reduced-motion'da bant hiç akmaz, düğme gizlenir, bant yatay kaydırılabilir olur ve kopya gizlenir.
import Medya from './Medya.astro';
import type { Izlenen } from '../lib/letterboxd';
import { letterboxdAfisi } from '../lib/letterboxd-afis';
import { puanYaz, tarihYaz } from '../lib/format';

interface Props {
  filmler: Izlenen[];
  ton?: 'koyu' | 'acik';
}
const { filmler, ton = 'koyu' } = Astro.props;
const kopyalar = [false, true];
---

{
  filmler.length > 0 && (
    <section class={`bant bant--${ton}`} data-dunya="sinema" aria-labelledby="izlenen-baslik">
      <div class="kap">
        <div class="bas-satiri">
          <h2 id="izlenen-baslik" class="h2">Son izlediklerim</h2>
          <p class="kucuk">
            Veriler <a href="https://letterboxd.com/">Letterboxd</a> günlüğümden, build sırasında alınır.
          </p>
        </div>
      </div>
      <div class="bolge">
        <input type="checkbox" id="akis-durdur" class="durdur-girdi" aria-label="Afiş akışını durdur" />
        <label for="akis-durdur" class="durdur">
          <span class="durdur-dur" aria-hidden="true">Akışı durdur</span>
          <span class="durdur-oynat" aria-hidden="true">Akışı oynat</span>
        </label>
        <div class="akis" role="group" aria-label="Son izlediğim filmler">
          <div class="iz">
            {kopyalar.map((kopya) => (
              <ul class="lista afisler" aria-hidden={kopya ? 'true' : undefined} inert={kopya ? true : undefined} data-kopya={kopya ? '' : undefined}>
                {filmler.map((f) => {
                  const afis = letterboxdAfisi(f.tmdbId);
                  return (
                    <li class="film">
                      {afis && (
                        <a class="afis" href={f.link} tabindex="-1" aria-hidden="true">
                          <Medya src={afis} oran="afis" alt="" width={300} />
                        </a>
                      )}
                      <p class="ad">
                        <a href={f.link}>{f.film}</a>
                      </p>
                      {f.yil && <p class="kucuk">{f.yil}</p>}
                      {f.puan !== undefined && <p class="puan">{puanYaz(f.puan)} / 5</p>}
                      {f.tarih && !Number.isNaN(f.tarih.valueOf()) && <p class="kucuk">{tarihYaz(f.tarih)}</p>}
                    </li>
                  );
                })}
              </ul>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .bolge {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  /* Onay kutusu görsel olarak gizli ama klavyeyle odaklanır ve Boşluk tuşuyla değişir */
  .durdur-girdi {
    position: absolute;
    top: 0;
    inset-inline-end: var(--kenar);
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
  }

  .durdur {
    align-self: flex-end;
    margin-inline-end: var(--kenar);
    margin-block-end: var(--aralik-2);
    padding: 0.55rem 1rem;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--murekkep);
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .durdur:hover {
    background: var(--murekkep);
    color: var(--zemin);
  }

  .durdur-girdi:focus-visible + .durdur {
    outline: 3px solid var(--vurgu);
    outline-offset: 3px;
  }

  .durdur-oynat,
  .durdur-girdi:checked + .durdur .durdur-dur {
    display: none;
  }

  .durdur-girdi:checked + .durdur .durdur-oynat {
    display: inline;
  }

  .akis {
    overflow: hidden;
    border-block: 1px solid var(--cizgi);
    padding-block: var(--aralik-3);
  }

  .iz {
    display: flex;
    width: max-content;
  }

  .afisler {
    display: flex;
    flex: none;
    gap: var(--aralik-3);
    padding-inline-end: var(--aralik-3);
  }

  .film {
    flex: none;
    width: clamp(7rem, 11vw, 9.5rem);
  }

  .film p {
    margin: 0;
  }

  .afis {
    display: block;
    margin-block-end: var(--aralik-2);
    text-decoration: none;
  }

  .afis :global(.medya-kalip) {
    display: block;
  }

  .ad {
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .ad a {
    text-decoration-color: transparent;
  }

  .ad a:hover,
  .ad a:focus-visible {
    text-decoration-color: var(--vurgu);
  }

  .puan {
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    font-weight: 600;
    color: var(--turkuaz-metin);
  }

  @media (prefers-reduced-motion: no-preference) {
    .iz {
      animation: akis 110s linear infinite;
    }

    /* Hover, klavye odağı ya da düğme: akış durur */
    .akis:hover .iz,
    .akis:focus-within .iz,
    .durdur-girdi:checked ~ .akis .iz {
      animation-play-state: paused;
    }

    @keyframes akis {
      to {
        transform: translateX(-50%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .durdur-girdi,
    .durdur {
      display: none;
    }

    .akis {
      overflow-x: auto;
    }

    [data-kopya] {
      display: none;
    }
  }
</style>
