---
// /yazilar/, /yazilar/sinema/, /yazilar/basketbol/ için ortak sayfa. Sekmeler JS'siz: her biri kendi URL'inde.
// Düzen (hepsi koyu): manşet (en yeni yazı, tam genişlik görüntü + sayfa başlığı), araçlar (sekmeler, arama, etiketler),
// bölüm girişleri (Sinema turkuaz, Basketbol turuncu çizgili) ve yazı satırları.
import Base from '../layouts/Base.astro';
import YaziSahnesi from './YaziSahnesi.astro';
import YaziSatiri from './YaziSatiri.astro';
import { BOLUM_ADLARI, BOLUM_URL, tumYazilar, yillaraGore, type Bolum } from '../lib/content';
import { slugify } from '../lib/slug';

interface Props {
  bolum?: Bolum;
}

const { bolum } = Astro.props;
const hepsi = await tumYazilar();
const yazilar = bolum ? hepsi.filter((y) => y.bolum === bolum) : hepsi;
const [manset, ...digerleri] = yazilar;

const sekmeler = [
  { ad: 'Tümü', href: '/yazilar/', adet: hepsi.length, aktif: !bolum },
  ...(['sinema', 'basketbol'] as const).map((b) => ({
    ad: BOLUM_ADLARI[b],
    href: BOLUM_URL[b],
    adet: hepsi.filter((y) => y.bolum === b).length,
    aktif: bolum === b,
  })),
];

// Etiket süzgeci: her etiket kendi sayfasına gider (JS'siz); en sık kullanılanlar önde.
const etiketler = new Map<string, { ad: string; adet: number }>();
for (const { entry } of yazilar) {
  for (const ad of entry.data.etiketler) {
    const slug = slugify(ad);
    etiketler.set(slug, { ad, adet: (etiketler.get(slug)?.adet ?? 0) + 1 });
  }
}
const etiketListesi = [...etiketler].sort((a, b) => b[1].adet - a[1].adet || a[1].ad.localeCompare(b[1].ad, 'tr'));

const baslik = bolum ? BOLUM_ADLARI[bolum] : 'Yazılar';
const aciklama = {
  tumu: 'Sinema ve basketbol üzerine yazılar, yeniden eskiye.',
  sinema: 'İzlediğim filmler üzerine yazılar ve puanlar.',
  basketbol: 'Maçlar, taktikler ve sezon notları.',
}[bolum ?? 'tumu'];
const bolumAciklama: Record<Bolum, string> = {
  sinema: 'Filmler, yönetmenler ve izleme notları. Puan, künye ve jenerik her yazının sonunda.',
  basketbol: 'Taktik notları, sezon başlangıçları ve sayılarla okunan maçlar.',
};
const rss = bolum ? `${BOLUM_URL[bolum]}rss.xml` : '/rss.xml';

// Bölümler: "Tümü"de her bölüm kendi girişiyle (yalnızca yazısı kalan bölüm çizilir); bölüm sayfasında tek bölüm.
const bolumler = (bolum ? [bolum] : (['sinema', 'basketbol'] as const))
  .map((b) => ({ bolum: b, yazilar: digerleri.filter((y) => y.bolum === b) }))
  .filter((b) => b.yazilar.length > 0);
---

<Base baslik={bolum ? `Yazılar · ${baslik}` : 'Yazılar'} aciklama={aciklama} bindirme={Boolean(manset)}>
  {
    manset ? (
      <YaziSahnesi yazi={manset} baslikEtiketi="h2" ozetli uzun oncelikli>
        <h1 id="yazilar-baslik" class="sayfa-h1" data-dunya={bolum}>
          <span class="satir"><span>{baslik}</span></span>
        </h1>
      </YaziSahnesi>
    ) : (
      <section class="bant bant--koyu bant--basi" data-dunya={bolum} aria-labelledby="yazilar-baslik">
        <div class="kap">
          <h1 id="yazilar-baslik" class="h1"><span class="satir"><span>{baslik}</span></span></h1>
          <p class="lede">{aciklama}</p>
        </div>
      </section>
    )
  }

  <section class="bant bant--koyu araclar-bandi" aria-label="Yazıları süz ve ara">
    <div class="kap">
      <nav class="sekmeler" aria-label="Yazı bölümleri">
        {
          sekmeler.map((s) => (
            <a href={s.href} aria-current={s.aktif ? 'page' : undefined}>
              {s.ad} <span class="adet">{s.adet}</span>
            </a>
          ))
        }
      </nav>
      <div class="araclar">
        <form class="ara-formu" action="/arama/" method="get" role="search">
          <label class="sr-only" for="yazi-ara">Yazılarda ara</label>
          <input id="yazi-ara" type="search" name="q" placeholder="Yazılarda ara" autocomplete="off" />
          <button type="submit">Ara</button>
        </form>
        <a class="rss" href={rss}>RSS ile takip et</a>
      </div>

      {
        etiketListesi.length > 0 && (
          <ul class="lista etiket-listesi" aria-label="Etikete göre süz">
            {etiketListesi.map(([slug, e]) => (
              <li>
                <a href={`/etiketler/${slug}/`}>
                  #{e.ad} <span class="adet">{e.adet}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        yazilar.length === 0 && (
          <p class="bos">
            Bu bölümde henüz yazı yok. Yazılar yayımlandığında burada görünecek; RSS ile de takip edebilirsiniz.
          </p>
        )
      }
    </div>
  </section>

  {
    bolumler.map((b) => (
      <section class="bant bant--koyu bolum-bandi" data-dunya={b.bolum} aria-labelledby={`bolum-${b.bolum}`}>
        <div class="kap">
          <div class="giris">
            <h2 id={`bolum-${b.bolum}`} class="h2">{BOLUM_ADLARI[b.bolum]}</h2>
            <p>{bolumAciklama[b.bolum]}</p>
          </div>
          {yillaraGore(b.yazilar).map(({ yil, yazilar: liste }) => (
            <section class="yil" aria-labelledby={`yil-${b.bolum}-${yil}`}>
              <h3 id={`yil-${b.bolum}-${yil}`}>{yil}</h3>
              <ul class="lista">
                {liste.map((yazi) => (
                  <li>
                    <YaziSatiri yazi={yazi} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .sayfa-h1 {
    font-size: clamp(2.75rem, 1rem + 7vw, 8rem);
    line-height: 0.9;
    margin-block-end: 0.4rem;
  }

  .araclar-bandi {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .araclar-bandi .sekmeler {
    margin-block-start: 0;
    margin-block-end: var(--aralik-4);
  }

  .araclar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--aralik-3) var(--aralik-5);
  }

  .ara-formu {
    display: flex;
    flex: 1 1 18rem;
    max-width: 30rem;
  }

  .ara-formu input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem var(--aralik-3);
    border: 1px solid var(--murekkep);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
  }

  .ara-formu input::placeholder {
    color: var(--soluk);
    opacity: 1;
  }

  .ara-formu button {
    padding: 0.75rem var(--aralik-4);
    border: 1px solid var(--murekkep);
    border-radius: 0;
    background: var(--murekkep);
    color: var(--zemin);
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  .rss {
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    font-weight: 500;
  }

  /* Etiketler gövdeden bir basamak küçük ve soluk; çizgi yalnızca hover/odakta */
  .etiket-listesi {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-2) var(--aralik-4);
    margin-block: var(--aralik-4) 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    font-weight: 500;
    color: var(--soluk);
  }

  .etiket-listesi a {
    color: var(--soluk);
  }

  .etiket-listesi a:hover,
  .etiket-listesi a:focus-visible {
    color: var(--murekkep);
  }

  .adet {
    font-weight: 400;
    opacity: 1;
  }

  .bos {
    max-width: var(--olcu);
    margin-block-start: var(--aralik-4);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .bolum-bandi {
    padding-block: clamp(2.5rem, 5vw, 5rem);
  }

  /* Bölüm girişi: dev bölüm adı + tek cümle; alt çizgi dünyanın rengi (Sinema turkuaz, Basketbol turuncu) */
  .giris {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--aralik-3) clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-block-end: var(--aralik-5);
    padding-block-end: 1.2rem;
    border-block-end: 1px solid var(--vurgu);
  }

  .giris p {
    max-width: 40ch;
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: 1.0625rem;
    color: var(--soluk);
  }

  .yil + .yil {
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
  }

  .yil h3 {
    padding-block-end: var(--aralik-2);
    border-block-end: 1px solid var(--cizgi);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    letter-spacing: -0.02em;
    color: var(--soluk);
  }

  @media (max-width: 52rem) {
    .giris {
      grid-template-columns: 1fr;
    }
  }
</style>
