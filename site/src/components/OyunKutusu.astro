---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  baslik: string;
  kapak: ImageMetadata;
  embedUrl: string;
  /** Düğme metni: oyunlarda "Oyna", diğerlerinde "Dene". */
  etiket?: string;
}

const { baslik, kapak, embedUrl, etiket = 'Oyna' } = Astro.props;
---

<!--
  Tıklanmadan iframe yok ve oyuna ait hiçbir istek atılmaz: başlangıçta yalnızca kapak görseli ve
  bir bağlantı var. JS yoksa bağlantı oyunu yeni sekmede açar. Betik Astro tarafından paketlenir ve hash'lenir; yalnızca bu bileşenin render edildiği
  sayfalara girer, bu yüzden diğer sayfalarda JS yoktur.
-->
<div class="oyun" data-oyun data-embed={embedUrl} data-baslik={baslik} data-etiket={etiket}>
  <div class="sahne" data-sahne>
    <Image src={kapak} alt="" width={1280} loading="eager" class="kapak" data-kapak />
    <a class="oyna" href={embedUrl} target="_blank" rel="noopener" aria-label={`${etiket}: ${baslik}`} data-oyna>
      {etiket}
    </a>
  </div>
  <div class="araclar" data-araclar hidden>
    <button type="button" data-tam-ekran hidden>Tam ekran</button>
    <button type="button" data-kapat>Oyunu kapat</button>
  </div>
  <p class="durum sr-only" role="status" data-durum></p>
</div>
<script>
  // Paketlenmiş (hash'li) betik: CSP 'unsafe-inline' gerektirmez. Yalnızca bu bileşenin render edildiği sayfalara girer.
  document.querySelectorAll<HTMLElement>('[data-oyun]').forEach((kutu) => {
    const al = <T extends HTMLElement>(ad: string) => kutu.querySelector<T>('[data-' + ad + ']')!;
    const sahne = al('sahne');
    const kapak = al('kapak');
    const oyna = al<HTMLAnchorElement>('oyna');
    const araclar = al('araclar');
    const tamEkran = al('tam-ekran');
    const kapat = al('kapat');
    const durum = al('durum');
    const baslik = kutu.dataset.baslik ?? '';
    let iframe: HTMLIFrameElement | null = null;

    if (document.fullscreenEnabled) tamEkran.hidden = false;

    oyna.addEventListener('click', (e) => {
      e.preventDefault();
      if (iframe) return;
      const kare = document.createElement('iframe');
      iframe = kare;
      kare.src = kutu.dataset.embed ?? '';
      kare.title = baslik + ' (gömülü)';
      kare.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-pointer-lock');
      kare.setAttribute('allow', 'fullscreen; gamepad');
      kare.setAttribute('referrerpolicy', 'no-referrer');
      kare.className = 'iframe';
      kapak.hidden = true;
      oyna.hidden = true;
      sahne.appendChild(kare);
      araclar.hidden = false;
      durum.textContent = baslik + ' yükleniyor.';
      kare.addEventListener('load', () => {
        durum.textContent = baslik + ' hazır.';
      });
      kare.focus();
    });

    tamEkran.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void sahne.requestFullscreen();
    });

    document.addEventListener('fullscreenchange', () => {
      tamEkran.textContent = document.fullscreenElement === sahne ? 'Tam ekrandan çık' : 'Tam ekran';
    });

    kapat.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      if (iframe) iframe.remove();
      iframe = null;
      kapak.hidden = false;
      oyna.hidden = false;
      araclar.hidden = true;
      durum.textContent = '';
      oyna.focus();
    });
  });
</script>

<style>
  .oyun {
    display: grid;
    gap: var(--aralik-3);
  }

  .sahne {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--murekkep);
  }

  .sahne :global(.kapak),
  .sahne :global(.iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sahne :global(.kapak) {
    object-fit: cover;
  }

  .sahne :global(.iframe) {
    background: var(--yuzey);
  }

  .oyna {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: max-content;
    height: max-content;
    padding: var(--aralik-3) var(--aralik-5);
    background: var(--murekkep);
    color: var(--zemin);
    font-family: var(--font-baslik-yigin);
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 1;
    text-decoration: none;
  }

  .oyna:hover {
    background: var(--turkuaz);
    color: var(--turkuaz-alan-metin);
  }

  .oyna:focus-visible {
    outline-color: var(--zemin);
    outline-offset: 4px;
  }

  .araclar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-3);
  }

  .araclar[hidden],
  .araclar button[hidden] {
    display: none;
  }

  button {
    padding: var(--aralik-2) var(--aralik-4);
    border: 3px solid var(--murekkep);
    background: transparent;
    color: var(--murekkep);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:hover {
    background: var(--murekkep);
    color: var(--zemin);
  }

  /* Tam ekranda sahne tüm ekranı kaplar */
  .sahne:fullscreen {
    aspect-ratio: auto;
  }
</style>
