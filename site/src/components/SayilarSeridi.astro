---
import { dilAl, sayiYaz, sozluk } from '../i18n';

interface Sayi {
  deger: number | string;
  etiket: string;
  not?: string;
}

interface Props {
  sayilar: Sayi[];
  ton?: 'koyu' | 'acik';
  etiket?: string;
}

const dil = dilAl(Astro);
const { sayilar, ton = 'koyu', etiket = sozluk(dil).ana.sayilarEtiket } = Astro.props;
---

<section class={`bant bant--${ton}`} aria-label={etiket}>
  <div class="kap">
    <dl class="sayilar">
      {
        sayilar.map((s) => (
          <div>
            <dt>{s.etiket}</dt>
            <dd class="sayi">{typeof s.deger === 'number' ? sayiYaz(s.deger, dil) : s.deger}</dd>
            {s.not && <dd class="not">{s.not}</dd>}
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .sayilar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0;
    border-block-start: 1px solid var(--cizgi);
  }

  /* Okuma sırası etiket → sayı; görsel sırası sayı önde */
  .sayilar div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--aralik-3);
    padding: clamp(1.5rem, 3vw, 3rem) clamp(1rem, 2vw, 2rem) clamp(1.5rem, 3vw, 3rem) 0;
  }

  .sayilar div + div {
    padding-inline-start: clamp(1rem, 2vw, 2rem);
    border-inline-start: 1px solid var(--cizgi);
  }

  dd {
    margin: 0;
  }

  .sayi {
    font-family: var(--font-bas);
    font-size: var(--yazi-sayi);
    font-weight: var(--bas-agirlik);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  dt {
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--soluk);
  }

  .not {
    order: -1;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  @media (max-width: 40rem) {
    .sayilar {
      grid-template-columns: 1fr;
    }

    .sayilar div + div {
      padding-inline-start: 0;
      border-inline-start: 0;
      border-block-start: 1px solid var(--cizgi);
    }
  }
</style>
