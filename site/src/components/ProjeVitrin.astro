---
// Ana sayfa proje vitrini: ilki büyük vitrin, kalanlar iki sütun.
import type { CollectionEntry } from 'astro:content';
import Medya from './Medya.astro';
import { DURUM, TUR } from '../lib/labels';

interface Props {
  projeler: CollectionEntry<'projeler'>[];
  ton?: 'koyu' | 'acik';
}

const { projeler, ton = 'koyu' } = Astro.props;
const [buyuk, ...digerleri] = projeler;
---

{
  buyuk && (
    <section class={`bant bant--${ton}`} data-dunya="proje" aria-labelledby="vitrin-baslik">
      <div class="kap">
        <div class="bas-satiri">
          <h2 id="vitrin-baslik" class="h2">Projeler</h2>
          <a href="/projeler/">Tüm projeler</a>
        </div>

        <article class="buyuk">
          <a class="gorsel" href={`/projeler/${buyuk.id}/`} tabindex="-1" aria-hidden="true">
            <Medya src={buyuk.data.gorsel} oran="proje" width={1400} />
          </a>
          <div class="baslik-satiri">
            <h3 class="buyuk-ad">
              <a href={`/projeler/${buyuk.id}/`}>{buyuk.data.ad}</a>
            </h3>
            <div>
              <p class="lede">{buyuk.data.ozet}</p>
              <dl>
                <dt>Tür</dt>
                <dd>{TUR[buyuk.data.tur]}</dd>
                <dt>Durum</dt>
                <dd>{DURUM[buyuk.data.durum]}</dd>
              </dl>
            </div>
          </div>
        </article>

        {
          digerleri.length > 0 && (
            <div class="ikili">
              {digerleri.map((p) => (
                <article class="kucuk">
                  <a class="gorsel" href={`/projeler/${p.id}/`} tabindex="-1" aria-hidden="true">
                    <Medya src={p.data.gorsel} oran="proje" width={900} />
                  </a>
                  <h3>
                    <a href={`/projeler/${p.id}/`}>{p.data.ad}</a>
                  </h3>
                  <p class="ozet">{p.data.ozet}</p>
                  <p class="kucuk-not">{TUR[p.data.tur]}</p>
                  <p class="kucuk-not">{DURUM[p.data.durum]}</p>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>
  )
}

<style>
  /* Proje görselleri (ekran görüntüsü/arayüz) 4:3 kaynaktan gelir; 16:10'a kırpılınca arayüz kesilir.
     Bu yüzden büyük vitrin görseli 4:3 basar ve yanında metinle iki sütun kurar. */
  .buyuk {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--aralik-4) clamp(2rem, 5vw, 6rem);
    align-items: end;
  }

  .gorsel {
    display: block;
    text-decoration: none;
  }

  .baslik-satiri {
    display: grid;
    gap: var(--aralik-4);
  }

  .buyuk-ad {
    font-size: clamp(3rem, 1rem + 5.5vw, 6.5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .buyuk .lede {
    color: var(--lede-renk);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.125rem var(--aralik-3);
    margin: var(--aralik-4) 0 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
  }

  dt {
    color: var(--soluk);
  }

  dd {
    margin: 0;
  }

  .ikili {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    margin-block-start: clamp(4rem, 8vw, 8rem);
  }

  .kucuk {
    display: grid;
    gap: var(--aralik-2);
    align-content: start;
  }

  .kucuk h3 {
    margin-block-start: var(--aralik-2);
    font-size: var(--yazi-h3);
  }

  .ozet {
    max-width: 44ch;
    margin: 0;
    color: var(--soluk);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .kucuk-not {
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    color: var(--soluk);
  }

  @media (max-width: 52rem) {
    .buyuk,
    .ikili {
      grid-template-columns: 1fr;
    }
  }
</style>
