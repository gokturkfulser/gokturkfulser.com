---
// Ana sayfa proje vitrini: dikey çerçeveler, çift sıradaki kareler aşağı kaymış (kademeli). Her proje için tür ve durum ayrı satır.
import type { CollectionEntry } from 'astro:content';
import Medya from './Medya.astro';
import { DURUM, TUR } from '../lib/labels';

interface Props {
  projeler: CollectionEntry<'projeler'>[];
  ton?: 'koyu' | 'acik';
}

const { projeler, ton = 'koyu' } = Astro.props;
---

{
  projeler.length > 0 && (
    <section class={`bant bant--${ton}`} data-dunya="proje" aria-labelledby="vitrin-baslik">
      <div class="kap">
        <div class="bas-satiri">
          <h2 id="vitrin-baslik" class="h2">Projeler</h2>
          <a href="/projeler/">Tüm projeler</a>
        </div>
        <ul class="lista dikeyler">
          {projeler.map((p) => (
            <li>
              <article class="dikey">
                <a class="gorsel" href={`/projeler/${p.id}/`} tabindex="-1" aria-hidden="true">
                  <Medya src={p.data.gorsel} oran="proje" width={900} class="ac" />
                </a>
                <h3>
                  <a href={`/projeler/${p.id}/`}>{p.data.ad}</a>
                </h3>
                <dl>
                  <dt>Tür</dt>
                  <dd>{TUR[p.data.tur]}</dd>
                  <dt>Durum</dt>
                  <dd>{DURUM[p.data.durum]}</dd>
                </dl>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .dikeyler {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: clamp(1rem, 2.4vw, 2rem);
    align-items: start;
  }

  .dikey {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    max-width: 26rem;
  }

  .gorsel {
    display: block;
    text-decoration: none;
  }

  li:nth-child(even) .dikey {
    margin-block-start: clamp(2rem, 6vw, 6rem);
  }

  h3 {
    font-size: clamp(1.625rem, 2.2vw, 2.2rem);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.8rem;
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  dd {
    margin: 0;
    color: var(--murekkep);
  }

  @media (max-width: 36rem) {
    li:nth-child(even) .dikey {
      margin-block-start: 0;
    }
  }
</style>
