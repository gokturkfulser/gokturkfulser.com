---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { DURUM, TUR, TUR_SIRASI } from '../lib/labels';

interface Props {
  /** Tüm projeler (sıralı: arşiv en sonda). */
  projeler: CollectionEntry<'projeler'>[];
  /** Seçili tür; yoksa hepsi. */
  tur?: (typeof TUR_SIRASI)[number];
}

const { projeler, tur } = Astro.props;
const turler = TUR_SIRASI.filter((t) => projeler.some((p) => p.data.tur === t));
const gorunen = tur ? projeler.filter((p) => p.data.tur === tur) : projeler;
const aktif = gorunen.filter((p) => p.data.durum !== 'arsiv');
const arsiv = gorunen.filter((p) => p.data.durum === 'arsiv');
const sayi = (t?: string) => (t ? projeler.filter((p) => p.data.tur === t).length : projeler.length);
---

{projeler.length > 0 && (
<nav class="suzgec" aria-label="Projeleri türe göre süz">
  <ul class="lista">
    <li>
      <a href="/projeler/" aria-current={tur ? undefined : 'page'}>Tümü <span class="sayi">{sayi()}</span></a>
    </li>
    {
      turler.map((t) => (
        <li>
          <a href={`/projeler/tur/${t}/`} aria-current={tur === t ? 'page' : undefined}>
            {TUR[t]} <span class="sayi">{sayi(t)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
)}

<ul class="lista akis">
  {
    aktif.map((p) => (
      <li class="proje" data-durum={p.data.durum} data-tur={p.data.tur}>
        <a class="gorsel" href={`/projeler/${p.id}/`} tabindex="-1" aria-hidden="true">
          <Image src={p.data.gorsel} alt="" width={700} loading="lazy" />
        </a>
        <div class="icerik">
          <h2>
            <a href={`/projeler/${p.id}/`}>{p.data.ad}</a>
          </h2>
          <p class="ozet">{p.data.ozet}</p>
          {p.data.durum === 'yakinda' && (
            <p class="yakinda-not">
              <strong>Yakında.</strong> Henüz yayında değil.
              {p.data.barindirma === 'vps' && ' VPS üzerinde çalışacak.'}
            </p>
          )}
          {p.data.stack.length > 0 && (
            <ul class="lista stack" aria-label="Kullanılan teknolojiler">
              {p.data.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          )}
          <dl>
            <dt>Tür</dt>
            <dd>{TUR[p.data.tur]}</dd>
            <dt>Durum</dt>
            <dd class="durum">{DURUM[p.data.durum]}</dd>
          </dl>
        </div>
      </li>
    ))
  }
</ul>

{
  arsiv.length > 0 && (
    <section class="arsiv" aria-labelledby="arsiv-baslik">
      <h2 id="arsiv-baslik">Arşiv</h2>
      <ul class="lista">
        {arsiv.map((p) => (
          <li>
            <a href={`/projeler/${p.id}/`}>{p.data.ad}</a>
            <span class="soluk">{p.data.ozet}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  aktif.length === 0 && arsiv.length === 0 && (
    <p class="bos">
      {tur ? 'Bu türde henüz proje yok.' : 'Henüz proje yok. Yayına alınan projeler burada listelenecek.'}
    </p>
  )
}

<style>
  .bos {
    max-width: var(--olcu);
    font-size: var(--yazi-lede);
    line-height: 1.5;
  }

  .suzgec {
    margin-block-end: var(--aralik-5);
  }

  .suzgec ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-1) var(--aralik-4);
  }

  .suzgec a {
    display: inline-block;
    padding-block: var(--aralik-2);
    text-decoration: none;
    border-block-end: 3px solid transparent;
    font-weight: 600;
  }

  .suzgec a:hover,
  .suzgec a[aria-current='page'] {
    border-block-end-color: currentColor;
  }

  .sayi {
    color: var(--soluk);
    font-weight: 400;
    font-size: var(--yazi-sm);
  }

  .akis {
    display: grid;
    gap: var(--aralik-5);
  }

  .proje {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: var(--aralik-3) var(--aralik-5);
    align-items: start;
  }

  .gorsel img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  h2 {
    font-size: var(--yazi-h2);
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
  }

  .ozet {
    max-width: 46ch;
    margin-block: var(--aralik-2) var(--aralik-3);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-1) var(--aralik-3);
    margin-block-end: var(--aralik-3);
    font-size: var(--yazi-sm);
    color: var(--soluk);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.125rem var(--aralik-3);
    margin: 0;
    font-size: var(--yazi-sm);
  }

  dt {
    color: var(--soluk);
  }

  dd {
    margin: 0;
  }

  /* Yakında olanlar listede ayrı okunur: durum kalın, görsel soluk */
  .proje[data-durum='yakinda'] .durum {
    font-weight: 800;
  }

  .yakinda-not {
    max-width: 40ch;
    margin-block-end: var(--aralik-3);
    padding-inline-start: var(--aralik-3);
    border-inline-start: 8px solid var(--turuncu);
    line-height: 1.5;
  }

  .proje[data-durum='yakinda'] .gorsel img {
    opacity: 0.7;
  }

  .arsiv {
    margin-block-start: var(--aralik-6);
  }

  .arsiv h2 {
    margin-block-end: var(--aralik-3);
    font-size: var(--yazi-h3);
    color: var(--soluk);
  }

  .arsiv ul {
    display: grid;
    gap: var(--aralik-2);
    font-size: 1.0625rem;
  }

  .arsiv li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--aralik-4);
  }

  .arsiv li a {
    font-weight: 600;
  }

  @media (max-width: 52rem) {
    .proje {
      grid-template-columns: 1fr;
    }
  }
</style>
