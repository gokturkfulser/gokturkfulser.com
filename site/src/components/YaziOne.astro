---
import { Image } from 'astro:assets';
import { BOLUM_ADLARI, yaziUrl, type Yazi } from '../lib/content';
import { tarihIso, tarihYaz } from '../lib/format';

interface Props {
  yazi: Yazi;
}

const { yazi } = Astro.props;
const { data, id } = yazi.entry;
---

<article class="one alan-zemin" data-dunya={yazi.bolum}>
  <div class="kap ic">
    <div class="metin-alani">
      <h2><a href={yaziUrl(yazi.bolum, id)}>{data.baslik}</a></h2>
      <div class="alt">
        <p class="ozet">{data.ozet}</p>
        <p class="zaman">
          <time datetime={tarihIso(data.tarih)}>{tarihYaz(data.tarih)}</time>
          <span>{BOLUM_ADLARI[yazi.bolum]}</span>
        </p>
      </div>
    </div>
    <Image
      src={data.kapak}
      alt=""
      width={1200}
      loading="eager"
      fetchpriority="high"
      class="kapak"
    />
  </div>
</article>

<style>
  .one {
    background: var(--dunya);
    color: var(--dunya-alan-metin);
  }

  .ic {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--aralik-5);
    align-items: stretch;
    padding-block: var(--aralik-6);
  }

  .metin-alani {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--aralik-5);
  }

  h2 {
    font-size: var(--yazi-dev);
    line-height: var(--satir-baslik);
    letter-spacing: -0.01em;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }

  .alt {
    display: grid;
    gap: var(--aralik-3);
  }

  .ozet {
    max-width: 36ch;
    font-size: var(--yazi-lede);
    line-height: 1.5;
  }

  .zaman {
    margin: 0;
    font-size: var(--yazi-sm);
    line-height: 1.5;
  }

  .zaman time,
  .zaman span {
    display: block;
  }

  .kapak {
    width: 100%;
    height: 100%;
    min-height: 16rem;
    object-fit: cover;
    align-self: stretch;
  }

  @media (max-width: 52rem) {
    .ic {
      grid-template-columns: 1fr;
    }

    .kapak {
      order: -1;
      height: auto;
      min-height: 0;
      aspect-ratio: 2.39 / 1;
    }
  }
</style>
