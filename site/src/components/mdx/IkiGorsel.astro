---
import Medya from '../Medya.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  sol: ImageMetadata;
  solAlt: string;
  sag: ImageMetadata;
  sagAlt: string;
  /** İki görsel için ortak altyazı. */
  altyazi?: string;
}
const { sol, solAlt, sag, sagAlt, altyazi } = Astro.props;
---

<figure class="iki">
  <div class="cift">
    <Medya src={sol} alt={solAlt} oran="proje" width={800} class="ac" />
    <Medya src={sag} alt={sagAlt} oran="proje" width={800} class="ac" />
  </div>
  {altyazi && <figcaption>{altyazi}</figcaption>}
</figure>

<style>
  .iki {
    margin-block: 1.6em;
  }

  .cift {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--aralik-2);
  }

  figcaption {
    margin-block-start: var(--aralik-2);
    font-size: var(--yazi-xs);
    line-height: 1.5;
    color: var(--soluk);
    hyphens: manual;
  }

  @media (max-width: 36rem) {
    .cift {
      grid-template-columns: 1fr;
    }
  }
</style>
