---
// En yeni gecenin listesi: önce gecenin 1 numarası öne çıkarılmış blokta (oyuncular, eylem, açıklama, videonun o anına bağlantı, puan),
// ardından 2. sıradan sonuncuya kadar liste. Video yalnızca düz metin bağlantıdır (iframe yok). `sezon` verilmezse en yeni sezon.
// Gece verisi yoksa boş durum. `inceleme: bekliyor` notu gecenin altında kalır.
import Top10Bos from './Top10Bos.astro';
import Top10Oyun from './Top10Oyun.astro';
import { top10Geceleri } from '../../lib/content';
import { tarihIso, tarihYaz } from '../../lib/format';
import { incelemeBekliyor, sonGece } from '../../lib/top10';
import { dilAl, sozluk } from '../../i18n';

interface Props {
  sezon?: string;
}

const dil = dilAl(Astro);
const s = sozluk(dil).top10;
const { geceler } = await top10Geceleri(Astro.props.sezon);
const gece = sonGece(geceler);
const oyunlar = gece ? [...gece.oyunlar].sort((a, b) => a.sira - b.sira) : [];
const birinci = oyunlar.find((o) => o.sira === 1);
const digerleri = oyunlar.filter((o) => o.sira !== 1);
const videoAlani = gece ? new URL(gece.video).hostname.replace(/^www\./, '') : '';
---

{
  !gece ? (
    <Top10Bos />
  ) : (
    <section class="kutu" aria-label={s.sonGece}>
      <div class="ust">
        <time datetime={tarihIso(gece.tarih)}>{tarihYaz(gece.tarih, dil)}</time>
        <span>{s.tur[gece.tur]}</span>
      </div>
      {
        birinci && (
          <div class="birinci">
            <p class="birinci-baslik">{s.birinciBaslik}</p>
            <Top10Oyun oyun={birinci} video={gece.video} buyuk />
          </div>
        )
      }
      {
        digerleri.length > 0 && (
          <ol start={2} aria-label={s.kalanSiralar(digerleri.at(-1)!.sira)}>
            {digerleri.map((o) => (
              <li>
                <Top10Oyun oyun={o} video={gece.video} />
              </li>
            ))}
          </ol>
        )
      }
      <p class="video">
        <a href={gece.video} rel="noopener noreferrer">{s.video(videoAlani)}</a>
      </p>
      {incelemeBekliyor(gece) && <p class="bekleyen-not">{s.bekleyenNot}</p>}
    </section>
  )
}

<style>
  .kutu {
    margin-block: 1.6em;
    font-family: var(--font-baslik-yigin);
    color: var(--murekkep);
  }

  .ust {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--aralik-1) var(--aralik-3);
    padding-block-end: var(--aralik-2);
    border-block-end: 3px solid var(--dunya-bant);
    font-size: var(--yazi-sm);
  }

  /* Gecenin tarihi başlık yerine geçer: kâğıtta Hanken, ≥ 24 px */
  time {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* 1 numara: tarih çizgisinin altında, kendi alt çizgisiyle ayrılır (kart, gölge ve gradient yok) */
  .birinci {
    border-block-end: 4px solid var(--dunya-bant);
    padding-inline-start: var(--aralik-3);
    border-inline-start: 4px solid var(--dunya-bant);
  }

  .birinci-baslik {
    margin: var(--aralik-3) 0 0;
    font-size: var(--yazi-sm);
    font-weight: 800;
  }

  .kutu ol {
    margin: 0;
    padding-inline-start: 2.2em;
    list-style: decimal;
    font-size: var(--yazi-sm);
    line-height: 1.4;
  }

  /* Dıştaki li list-item kalır (sıra numarası işareti); düzen Top10Oyun'dadır. */
  .kutu ol > li {
    padding-inline-start: 0.4em;
    border-block-end: 1px solid var(--cizgi);
  }

  .kutu ol > li + li {
    margin-block-start: 0;
  }

  /* Sıra numarası liste işaretidir; kâğıt bandında ink rengi (turuncu işaret < 7:1 olurdu) */
  .kutu ol > li::marker {
    color: var(--murekkep);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .video {
    margin-block: var(--aralik-3) 0;
    font-size: var(--yazi-sm);
  }

  /* Otomatik çıkarılmış, henüz kontrol edilmemiş gece: yalnızca düz metin notu (renk, ikon, ok yok). */
  .bekleyen-not {
    margin-block: var(--aralik-2) 0;
    font-size: var(--yazi-xs);
    line-height: 1.5;
  }

  /* Bağlantı: ink metin, vurgu renkli alt çizgi (turuncu metin < 7:1 olurdu) */
  .video a {
    color: var(--murekkep);
    font-weight: 600;
  }
</style>
