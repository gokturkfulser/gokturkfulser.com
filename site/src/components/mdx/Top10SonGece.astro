---
// En yeni gecenin listesi: her oyunda sıra, eylem, katkı sahipleri (rol ve kişi başı puanla), etiketler, varsa açıklama ve rakip.
// Video yalnızca düz metin bağlantıdır (iframe yok). `sezon` verilmezse en yeni sezon. Gece verisi yoksa boş durum.
import Top10Bos from './Top10Bos.astro';
import { top10Geceleri } from '../../lib/content';
import { ondalikYaz, tarihIso, tarihYaz } from '../../lib/format';
import { incelemeBekliyor, katkiBirimi, katkiPaylari, PUAN_BIRIMI, sonGece, videoZamanAdresi } from '../../lib/top10';
import { etiketAdi, eylemAdi, rolAdi } from '../../lib/top10-sozluk';
import { dilAl, sozluk } from '../../i18n';

interface Props {
  sezon?: string;
}

const dil = dilAl(Astro);
const s = sozluk(dil).top10;
const { geceler } = await top10Geceleri(Astro.props.sezon);
const gece = sonGece(geceler);
const oyunlar = gece ? [...gece.oyunlar].sort((a, b) => a.sira - b.sira) : [];
const videoAlani = gece ? new URL(gece.video).hostname.replace(/^www\./, '') : '';
---

{
  !gece ? (
    <Top10Bos />
  ) : (
    <section class="kutu" data-dunya="basketbol" aria-label={s.sonGece}>
      <div class="ust">
        <time datetime={tarihIso(gece.tarih)}>{tarihYaz(gece.tarih, dil)}</time>
        <span>{s.tur[gece.tur]}</span>
      </div>
      <ol>
        {oyunlar.map((o) => {
          const paylar = katkiPaylari(o.katkilar);
          return (
            <li>
              <div class="oyun">
                {o.eylem && <p class="eylem">{eylemAdi(o.eylem, dil)}</p>}
                <ul class="katkilar" role="list">
                  {o.katkilar.map((k, i) => {
                    const deger = katkiBirimi(o.sira, paylar[i]!) / PUAN_BIRIMI;
                    return (
                      <li>
                        <span class="ad">{k.oyuncu}</span>{' '}
                        <span class="takim">{k.takim}</span>{' '}
                        {(o.katkilar.length > 1 || k.rol !== 'bitiren') && <span class="rol">{rolAdi(k.rol, dil)}</span>}
                        <span class="puan">{s.puanlar(deger, ondalikYaz(deger, dil))}</span>
                      </li>
                    );
                  })}
                </ul>
                {o.etiketler && o.etiketler.length > 0 && (
                  <ul class="oyun-etiketleri" role="list">
                    {o.etiketler.map((e) => (
                      <li>{etiketAdi(e, dil)}</li>
                    ))}
                  </ul>
                )}
                {o.aciklama && <p class="ek">{o.aciklama}</p>}
                {o.zaman && (
                  <p class="ek zaman">
                    {videoZamanAdresi(gece.video, o.zaman) ? (
                      <a href={videoZamanAdresi(gece.video, o.zaman)} rel="noopener noreferrer">{s.videodaZaman(o.zaman)}</a>
                    ) : (
                      s.videodaZaman(o.zaman)
                    )}
                  </p>
                )}
                {o.rakip && (
                  <p class="ek">
                    {s.rakip}: {o.rakip}
                  </p>
                )}
              </div>
            </li>
          );
        })}
      </ol>
      <p class="video">
        <a href={gece.video} rel="noopener noreferrer">{s.video(videoAlani)}</a>
      </p>
      {incelemeBekliyor(gece) && <p class="bekleyen-not">{s.bekleyenNot}</p>}
    </section>
  )
}

<style>
  .kutu {
    margin-block: 1.6em;
    font-family: var(--font-baslik-yigin);
    color: var(--murekkep);
  }

  .ust {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--aralik-1) var(--aralik-3);
    padding-block-end: var(--aralik-2);
    border-block-end: 3px solid var(--dunya-bant);
    font-size: var(--yazi-sm);
  }

  /* Gecenin tarihi başlık yerine geçer: kâğıtta Hanken, ≥ 24 px */
  time {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .kutu ol {
    margin: 0;
    padding-inline-start: 2.2em;
    list-style: decimal;
    font-size: var(--yazi-sm);
    line-height: 1.4;
  }

  /* Dıştaki li list-item kalır (sıra numarası işareti); düzen içteki kaplarda. */
  .kutu ol > li {
    padding-inline-start: 0.4em;
    border-block-end: 1px solid var(--cizgi);
  }

  .kutu ol > li + li {
    margin-block-start: 0;
  }

  /* Sıra numarası liste işaretidir; kâğıt bandında ink rengi (turuncu işaret < 7:1 olurdu) */
  .kutu ol > li::marker {
    color: var(--murekkep);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .oyun {
    display: grid;
    gap: 0.3rem;
    padding-block: var(--aralik-2);
  }

  .kutu .oyun p,
  .kutu .oyun ul {
    margin: 0;
  }

  .eylem {
    font-weight: 800;
    font-size: var(--yazi-xs);
  }

  .kutu .katkilar,
  .kutu .oyun-etiketleri {
    padding: 0;
    list-style: none;
  }

  /* İç li'ler kendi satırında; dıştaki li kuralları (kenar çizgisi, boşluk) buraya inmez. */
  .kutu .katkilar > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--aralik-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ad {
    font-weight: 700;
  }

  .rol {
    font-size: var(--yazi-xs);
  }

  .puan {
    margin-inline-start: auto;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .kutu .oyun-etiketleri {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-1) var(--aralik-2);
    font-size: var(--yazi-xs);
  }

  .kutu .oyun-etiketleri > li {
    margin: 0;
    padding: 0 0.5rem;
    border: 1px solid var(--cizgi);
  }

  .ek {
    font-size: var(--yazi-xs);
  }

  /* Oyunun videodaki zamanına bağlantı: ink metin, vurgu renkli alt çizgi (genel bağlantı stili) */
  .zaman a {
    color: var(--murekkep);
    font-weight: 600;
  }

  .video {
    margin-block-start: var(--aralik-3);
    font-size: var(--yazi-sm);
  }

  /* Otomatik çıkarılmış, henüz kontrol edilmemiş gece: yalnızca düz metin notu (renk, ikon, ok yok). */
  .bekleyen-not {
    margin-block-start: var(--aralik-2);
    font-size: var(--yazi-xs);
    line-height: 1.5;
  }

  /* Bağlantı: ink metin, vurgu renkli alt çizgi (turuncu metin < 7:1 olurdu) */
  .video a {
    color: var(--murekkep);
    font-weight: 600;
  }
</style>
