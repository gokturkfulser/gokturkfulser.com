---
// Sezon sıralaması (ilk 20): sıra, oyuncu, son takım, toplam puan, gece sayısı, 1 numara sayısı ve bir önceki geceye kadarki sıraya göre
// değişim ("+2", "−1", "=", "yeni"; metin, ok yok). Veri `top10` koleksiyonu, hesap lib/top10.ts ve lib/top10-ozet.ts. `sezon` verilmezse en yeni sezon. Gece verisi yoksa boş durum. Sıfır JS; geniş tablo yalnızca kendi kabında kayar.
import Top10Bos from './Top10Bos.astro';
import Top10Podyum from './Top10Podyum.astro';
import { top10Geceleri } from '../../lib/content';
import { ondalikYaz, sayiYaz } from '../../lib/format';
import { degisimMetni, siralamaDegisimi } from '../../lib/top10-ozet';
import { dilAl, sozluk } from '../../i18n';

interface Props {
  /** Sezon klasörü adı (ör. "2026-27"); yoksa en yeni sezon. */
  sezon?: string;
  /** Gösterilecek satır sayısı (varsayılan 20). */
  sinir?: number;
}

const dil = dilAl(Astro);
const s = sozluk(dil).top10;
const { sezon, geceler } = await top10Geceleri(Astro.props.sezon);
const sinir = Astro.props.sinir ?? 20;
const tablo = siralamaDegisimi(geceler, sinir);
const baslik = s.siralama(sezon ?? '', tablo.length);
const podyum = tablo.slice(0, 3);
const kalan = tablo.slice(3);
---

{
  tablo.length === 0 ? (
    <Top10Bos />
  ) : (
    <div class="kutu">
      <p class="baslik" id="top10-siralama-baslik">{baslik}</p>
      <Top10Podyum
        ad={baslik}
        oyuncular={podyum.map(({ satir, sira, degisim }) => ({
          sira: sayiYaz(sira, dil),
          ad: satir.oyuncu,
          takim: satir.takim,
          sayilar: [
            { etiket: s.sutun.puan, deger: ondalikYaz(satir.puan, dil) },
            { etiket: s.sutun.gece, deger: sayiYaz(satir.gece, dil) },
            { etiket: s.sutun.birinci, deger: sayiYaz(satir.birinci, dil) },
            { etiket: s.sutun.degisim, deger: degisimMetni(degisim, s.degisimYeni) },
          ],
        }))}
      />
      {kalan.length > 0 && <div class="sarmal" role="region" aria-labelledby="top10-siralama-baslik" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col" class="sayi">{s.sutun.sira}</th>
              <th scope="col">{s.sutun.oyuncu}</th>
              <th scope="col">{s.sutun.takim}</th>
              <th scope="col" class="sayi">{s.sutun.puan}</th>
              <th scope="col" class="sayi">{s.sutun.gece}</th>
              <th scope="col" class="sayi">{s.sutun.birinci}</th>
              <th scope="col" class="sayi">{s.sutun.degisim}</th>
            </tr>
          </thead>
          <tbody>
            {kalan.map(({ satir, sira, degisim }) => (
              <tr>
                <td class="sayi">{sayiYaz(sira, dil)}</td>
                <th scope="row">{satir.oyuncu}</th>
                <td>{satir.takim}</td>
                <td class="sayi puan">{ondalikYaz(satir.puan, dil)}</td>
                <td class="sayi">{sayiYaz(satir.gece, dil)}</td>
                <td class="sayi">{sayiYaz(satir.birinci, dil)}</td>
                <td class="sayi">{degisimMetni(degisim, s.degisimYeni)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>}
      <p class="not">{s.puanNotu}</p>
    </div>
  )
}

<style>
  /* Kâğıt bandında okunur: küçük metin yalnızca --murekkep (≥ 7:1); turuncu yalnızca çizgi ve dolgu (≥ 3:1). */
  .kutu {
    margin-block: 1.6em;
  }

  .sarmal {
    overflow-x: auto;
    background: var(--yuzey);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    line-height: 1.35;
    color: var(--murekkep);
    hyphens: manual;
    font-variant-numeric: tabular-nums;
  }

  .baslik {
    margin: 0 0 var(--aralik-3);
    font-family: var(--font-baslik-yigin);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--murekkep);
  }

  .sarmal {
    margin-block-start: var(--aralik-4);
  }

  th,
  td {
    padding: var(--aralik-2) clamp(0.4rem, 2vw, var(--aralik-3));
    text-align: start;
    vertical-align: baseline;
  }

  thead th {
    font-weight: 700;
    border-block-end: 3px solid var(--dunya-bant);
  }

  tbody th {
    font-weight: 600;
  }


  tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--dunya-bant) 8%, transparent);
  }

  .sayi {
    text-align: end;
  }

  .puan {
    font-weight: 700;
  }

  .not {
    margin-block-start: var(--aralik-2);
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    line-height: 1.5;
    color: var(--murekkep);
  }

  @media (max-width: 30rem) {
    table {
      font-size: var(--yazi-xs);
    }

    .baslik {
      font-size: 1.25rem;
    }

    th,
    td {
      padding-inline: 0.35rem;
    }
  }
</style>
