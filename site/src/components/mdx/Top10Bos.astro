import { dilAl, sozluk } from '../../i18n';

const s = sozluk(dilAl(Astro)).top10;
---

<p class="bos">{s.bos}</p>

<style>
  .bos {
    padding-inline-start: var(--aralik-3);
    border-inline-start: 3px solid var(--dunya-bant);
    color: var(--murekkep);
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    line-height: 1.5;
  }
</style>
