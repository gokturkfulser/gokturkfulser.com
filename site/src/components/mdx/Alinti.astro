---
interface Props {
  /** Alıntının sahibi (isteğe bağlı): kişi, film ya da kaynak. */
  kaynak?: string;
}
const { kaynak } = Astro.props;
---

<!-- Büyük alıntı: yazı sayfasında sayfa genişliğine taşar (prose.css `.yazi-metni > .alinti`), vurgu rengiyle çift kenar çizgisi. -->
<figure class="alinti">
  <blockquote>
    <slot />
  </blockquote>
  {kaynak && <figcaption>{kaynak}</figcaption>}
</figure>

<style>
  .alinti {
    justify-self: center;
    width: 100%;
    max-width: 50rem;
    margin-block: 1.6em;
    padding-block: 1.1rem;
    border-block: 4px solid var(--dunya-bant);
  }

  .alinti blockquote {
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-weight: 600;
    font-size: clamp(1.625rem, 1.1rem + 2vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--murekkep);
    hyphens: manual;
  }

  figcaption {
    margin-block-start: var(--aralik-2);
    font-family: var(--font-metin-yigin);
    font-size: var(--yazi-xs);
    line-height: 1.5;
    color: var(--soluk);
  }
</style>
