---
// /projeler/ ve /projeler/tur/<tur>/ için ortak sayfa. Süzgeç JS'siz: her tür kendi URL'inde.
// Düzen (koyu): sayfa başı, ardından dev proje dizini. Hover/odakta görsel önizleme saf CSS ile açılır
// (yalnızca (hover: hover) ve geniş ekran; önizleme kendi şeridinde, metne binmez); dokunmatikte küçük görsel satır içindedir.
// Arşiv en sonda sade liste.
import Base from '../layouts/Base.astro';
import Medya from './Medya.astro';
import type { CollectionEntry } from 'astro:content';
import { DURUM, TUR, TUR_SIRASI } from '../lib/labels';

interface Props {
  /** Tüm projeler (sıralı: arşiv en sonda). */
  projeler: CollectionEntry<'projeler'>[];
  /** Seçili tür; yoksa hepsi. */
  tur?: (typeof TUR_SIRASI)[number];
}

const { projeler, tur } = Astro.props;
const turler = TUR_SIRASI.filter((t) => projeler.some((p) => p.data.tur === t));
const gorunen = tur ? projeler.filter((p) => p.data.tur === tur) : projeler;
const aktif = gorunen.filter((p) => p.data.durum !== 'arsiv');
const arsiv = gorunen.filter((p) => p.data.durum === 'arsiv');
const sayi = (t?: string) => (t ? projeler.filter((p) => p.data.tur === t).length : projeler.length);

const baslik = tur ? `Projeler: ${TUR[tur]}` : 'Projeler';
const aciklama = tur ? `${TUR[tur]} türündeki projelerim.` : 'Yaptığım oyunlar, uygulamalar, siteler ve araçlar.';
/** "Oyna" (oyun) ya da "Aç": yalnızca yayında olan ve canlı adresi bulunan projede. */
const canliEtiket = (p: CollectionEntry<'projeler'>) =>
  p.data.durum !== 'yakinda' && p.data.url ? (p.data.tur === 'oyun' ? 'Oyna' : 'Aç') : undefined;
---

<Base baslik={baslik} aciklama={aciklama}>
  <section class="bant bant--koyu bant--basi" aria-labelledby="projeler-baslik">
    <div class="kap">
      <h1 id="projeler-baslik" class="h1"><span class="satir"><span>Projeler</span></span></h1>
      <p class="lede">Oyunlar, küçük uygulamalar ve siteler. Her kayıt neyin yayında olduğunu söylüyor.</p>
      {
        projeler.length > 0 && (
          <nav class="sekmeler" aria-label="Projeleri türe göre süz">
            <a href="/projeler/" aria-current={tur ? undefined : 'page'}>
              Tümü <span class="adet">{sayi()}</span>
            </a>
            {turler.map((t) => (
              <a href={`/projeler/tur/${t}/`} aria-current={tur === t ? 'page' : undefined}>
                {TUR[t]} <span class="adet">{sayi(t)}</span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </section>

  {
    aktif.length > 0 && (
      <section class="bant bant--koyu dizin-bandi" aria-label="Proje dizini">
        <div class="kap">
          <ul class="lista dizin">
            {aktif.map((p) => (
              <li data-dunya="proje" data-durum={p.data.durum} data-tur={p.data.tur}>
                <article class="satir-proje">
                  <h2 class="ad">
                    <a href={`/projeler/${p.id}/`}>{p.data.ad}</a>
                  </h2>
                  <div class="detay">
                    <p class="ozet">{p.data.ozet}</p>
                    {p.data.durum === 'yakinda' && (
                      <p class="yakinda-not">
                        <strong>Yakında.</strong> Henüz yayında değil.
                        {p.data.barindirma === 'vps' && ' VPS üzerinde çalışacak.'}
                      </p>
                    )}
                    <dl>
                      <dt>Tür</dt>
                      <dd>{TUR[p.data.tur]}</dd>
                      <dt>Durum</dt>
                      <dd>{DURUM[p.data.durum]}</dd>
                      {p.data.stack.length > 0 && (
                        <>
                          <dt>Teknoloji</dt>
                          <dd>{p.data.stack.slice(0, 3).join(', ')}</dd>
                        </>
                      )}
                    </dl>
                    <p class="eylemler">
                      {canliEtiket(p) && <a class="eylem" href={p.data.url}>{canliEtiket(p)}</a>}
                      <a class="eylem" href={`/projeler/${p.id}/`}>Projeyi incele</a>
                    </p>
                    <div class="kucuk-gorsel" aria-hidden="true">
                      <Medya src={p.data.gorsel} oran="proje" width={600} />
                    </div>
                  </div>
                  <div class="onizleme" aria-hidden="true">
                    <Medya src={p.data.gorsel} oran="proje" width={700} />
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    arsiv.length > 0 && (
      <section class="bant bant--koyu arsiv" aria-labelledby="arsiv-baslik">
        <div class="kap">
          <h2 id="arsiv-baslik" class="h3">Arşiv</h2>
          <ul class="lista">
            {arsiv.map((p) => (
              <li>
                <a href={`/projeler/${p.id}/`}>{p.data.ad}</a>
                <span class="soluk">{p.data.ozet}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    aktif.length === 0 && arsiv.length === 0 && (
      <section class="bant bant--koyu" aria-label="Boş durum">
        <div class="kap">
          <p class="bos">
            {tur ? 'Bu türde henüz proje yok.' : 'Henüz proje yok. Yayına alınan projeler burada listelenecek.'}
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .dizin-bandi {
    padding-block-start: 0;
  }

  .dizin li {
    border-block-start: 1px solid var(--cizgi);
  }

  .dizin li:last-child {
    border-block-end: 1px solid var(--cizgi);
  }

  .satir-proje {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: start;
    gap: 0.6rem 2rem;
    padding-block: clamp(1.1rem, 2.4vw, 2rem);
  }

  .ad {
    font-size: clamp(2.75rem, 1rem + 7vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  /* Satırın tamamı bağlantıdır; içindeki diğer bağlantılar (Oyna/Aç) üstte kalır */
  .ad a {
    text-decoration-color: transparent;
  }

  .ad a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .detay {
    display: grid;
    gap: 0.7rem;
    padding-block-start: 0.6rem;
  }

  .ozet {
    max-width: 38ch;
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: #dcd7ce;
  }

  .yakinda-not {
    margin: 0;
    padding-inline-start: var(--aralik-3);
    border-inline-start: 6px solid var(--turuncu-metin);
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.9rem;
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  dd {
    margin: 0;
    color: var(--murekkep);
  }

  .eylemler {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem var(--aralik-4);
    margin: 0;
  }

  .eylem {
    position: relative;
    z-index: 2;
    font-family: var(--font-baslik-yigin);
    font-size: 1rem;
    font-weight: 600;
  }

  li[data-durum='yakinda'] :global(img) {
    opacity: 0.7;
  }

  .onizleme {
    display: none;
  }

  .kucuk-gorsel {
    max-width: 22rem;
  }

  @media (hover: hover) and (min-width: 56.25rem) {
    /* Önizleme şeridi: satırın sağında ayrılmış alan; metin sütunları onun soluna sığar, önizleme metne binmez */
    .satir-proje {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) clamp(13rem, 22vw, 21rem);
    }

    .kucuk-gorsel {
      display: none;
    }

    .onizleme {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: center;
      rotate: -2deg;
      pointer-events: none;
      z-index: 3;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.55s var(--ease);
    }

    li:hover .onizleme,
    li:focus-within .onizleme {
      clip-path: inset(0);
    }

    li:hover .ad a,
    li:focus-within .ad a {
      text-decoration-color: var(--vurgu);
    }
  }

  @media (max-width: 56.1875rem), (hover: none) {
    .satir-proje {
      grid-template-columns: 1fr;
    }

    .ad {
      font-size: clamp(2.6rem, 11vw, 5rem);
    }
  }

  .arsiv ul {
    margin-block-start: var(--aralik-3);
  }

  .arsiv li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--aralik-2) var(--aralik-5);
    padding-block: var(--aralik-3);
    border-block-start: 1px solid var(--cizgi);
    font-family: var(--font-baslik-yigin);
  }

  .bos {
    max-width: var(--olcu);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  @media (max-width: 52rem) {
    .arsiv li {
      grid-template-columns: 1fr;
    }
  }
</style>
