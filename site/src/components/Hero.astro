---
// Ana sayfa hero'su: ad bloğu solda, build gününe göre değişen SVG sahne bandın arka planında (sağa yaslı, sola doğru erir).
// Adın altındaki cümle (lede) isteğe bağlıdır; verilmezse hiç render edilmez.
import HeroSahne from './HeroSahne.astro';

interface Props {
  /** Başlığın altındaki tek cümle (isteğe bağlı). */
  cumle?: string;
}

const { cumle } = Astro.props;
// Build günü: sahnenin küçük varyasyonu (ışığın yönü, açısı, toz) için tohum; aynı gün aynı çıktı.
const tohum = Math.floor(Date.now() / 86_400_000);
---
<section class="bant bant--koyu hero" aria-labelledby="hero-baslik">
  <div class="kap hero-izgara">
    <div class="hero-metin">
      <h1 id="hero-baslik" class="dev"><span>Göktürk</span> <span>Fulser</span></h1>
      {cumle && <p class="lede">{cumle}</p>}
      <p class="baglantilar">
        <a href="/yazilar/">Yazılara git</a>
        <a href="/projeler/">Projelere git</a>
      </p>
    </div>
    <div class="hero-gorsel" aria-hidden="true">
      <HeroSahne {tohum} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--nav));
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(3rem, 6vw, 6rem);
  }

  .hero-izgara {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
  }

  .hero-metin {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  h1 {
    font-size: var(--yazi-dev);
    line-height: 0.96;
    letter-spacing: -0.058em;
  }

  h1 span {
    display: block;
  }

  .lede {
    margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Lede yokken bağlantılar doğrudan adın altında durur */
  .baglantilar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-2) var(--aralik-5);
    margin: var(--aralik-5) 0 0;
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .hero-metin {
    position: relative;
    z-index: 1;
  }

  /* Sahne bandın arka planıdır: sağa yaslı, sol ve alt kenarı arka plana erir */
  .hero-gorsel {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -1;
    width: min(78%, 72rem);
    display: flex;
    flex-direction: column;
    min-width: 0;
    mask-image:
      linear-gradient(to right, transparent, #000 40%),
      linear-gradient(to bottom, #000 80%, transparent);
    mask-composite: intersect;
  }

  @media (prefers-reduced-motion: no-preference) {
    h1 {
      animation: hero-giris 0.9s var(--ease) both;
    }

    @keyframes hero-giris {
      from {
        opacity: 0;
        transform: translateY(1.5rem);
      }
    }
  }

  @media (max-width: 52rem) {
    .hero {
      min-height: 0;
    }

    /* Mobilde sahne tüm bandın arkasında, metnin okunması için biraz kısık */
    .hero {
      min-height: 32rem;
    }

    .hero-gorsel {
      width: 100%;
      opacity: 0.55;
      mask-image: linear-gradient(to bottom, #000 40%, transparent);
    }
  }
</style>
