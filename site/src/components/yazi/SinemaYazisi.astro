---
import Medya from '../Medya.astro';
import YaziBasi from './YaziBasi.astro';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Etiketler from '../../components/Etiketler.astro';
import { mdxBilesenleri } from '../../components/mdx';
import { puanYaz } from '../../lib/format';
import { filmYorumuLd, grafLd, makaleLd } from '../../lib/jsonld';
import { okumaSuresi } from '../../lib/okuma-suresi';
import { tmdbKaydi, tmdbUrl } from '../../lib/tmdb';

interface Props {
  entry: CollectionEntry<'sinema'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const { film } = data;

const tmdb = tmdbKaydi(film.tmdbId);
const orijinalAd = film.orijinalAd ?? tmdb?.orijinalBaslik;
const orijinal = orijinalAd && orijinalAd !== film.ad ? orijinalAd : undefined;
const sure = okumaSuresi(entry.body);
const ogYolu = `/og/sinema/${entry.id}.png`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogYolu, Astro.site).href;

const ld = grafLd(
  makaleLd({
    baslik: data.baslik,
    ozet: data.ozet,
    tarih: data.tarih,
    url,
    gorsel: ogUrl,
    bolumAdi: 'Sinema',
    etiketler: data.etiketler,
    kelime: sure.kelime,
    dakika: sure.dakika,
  }),
  ...(data.puan !== undefined
    ? [
        filmYorumuLd({
          baslik: data.baslik,
          ozet: data.ozet,
          tarih: data.tarih,
          url,
          film: { ad: film.ad, orijinalAd: orijinal, yil: film.yil, yonetmen: film.yonetmen },
          puan: data.puan,
          tmdbUrl: film.tmdbId ? tmdbUrl(film.tmdbId) : undefined,
        }),
      ]
    : []),
);
---

<Base baslik={data.baslik} aciklama={data.ozet} tur="article" ogGorsel={ogYolu} jsonLd={ld} bindirme>
  <article data-dunya="sinema" data-pagefind-body>
    <YaziBasi yazi={{ bolum: 'sinema', entry }} dakika={sure.dakika}>
      <span slot="meta">{film.yonetmen}, {film.yil}</span>
    </YaziBasi>

    <!-- Kâğıt bandı: kapaktan sonra okuma alanı basılı sayfaya geçer (sert bant değişimi) -->
    <div class="bant bant--acik govde">
      <div class="kap">
        <div class="yazi-metni">
          <aside class="kenar-notu" aria-label="Künye">
            <dl>
              <div>
                <dt>Film</dt>
                <dd>{film.ad}{orijinal && <> ({orijinal})</>}</dd>
              </div>
              <div>
                <dt>Yönetmen</dt>
                <dd>{film.yonetmen}</dd>
              </div>
              <div>
                <dt>Yıl</dt>
                <dd>{film.yil}</dd>
              </div>
              {
                data.puan !== undefined && (
                  <div>
                    <dt>Puanım</dt>
                    <dd>{puanYaz(data.puan)} / 5</dd>
                  </div>
                )
              }
            </dl>
          </aside>
          <Content components={mdxBilesenleri} />
          <Etiketler etiketler={data.etiketler} />
        </div>
      </div>
    </div>

    <!-- Film künyesi yazının sonunda, jenerik düzeninde (koyu bant) -->
    <section class="bant bant--koyu jenerik" aria-labelledby="jenerik-baslik">
      <div class="kap jenerik-ic">
        <h2 id="jenerik-baslik" class="sr-only">Film künyesi</h2>
        {
          tmdb?.afisGorsel && (
            <Medya class="afis" src={tmdb.afisGorsel} oran="afis" alt={`${film.ad} filminin afişi`} width={320} />
          )
        }
        <dl class="liste">
          <div>
            <dt>Film</dt>
            <dd>{film.ad}{orijinal && <> ({orijinal})</>}</dd>
          </div>
          <div>
            <dt>Yönetmen</dt>
            <dd>{film.yonetmen}</dd>
          </div>
          <div>
            <dt>Yapım yılı</dt>
            <dd>{film.yil}</dd>
          </div>
          {
            tmdb?.sure && (
              <div>
                <dt>Süre</dt>
                <dd>{tmdb.sure} dakika</dd>
              </div>
            )
          }
          {
            tmdb && tmdb.turler.length > 0 && (
              <div>
                <dt>Tür</dt>
                <dd>{tmdb.turler.join(', ')}</dd>
              </div>
            )
          }
          {
            data.puan !== undefined && (
              <div>
                <dt>Puanım</dt>
                <dd class="puan">{puanYaz(data.puan)} <span>/ 5</span></dd>
              </div>
            )
          }
        </dl>
      </div>
    </section>
  </article>
</Base>

<style>
  .govde {
    padding-block-start: calc(var(--bant) * 0.7);
    padding-block-end: calc(var(--bant) * 0.7);
  }

  .govde :global(.etiketler) {
    margin-block-start: var(--aralik-5);
    padding-block-start: var(--aralik-4);
    border-block-start: 1px solid var(--cizgi);
  }

  /* Kenar notu (künye): Hanken, kâğıt */
  .kenar-notu {
    padding-block-start: 0.6rem;
    border-block-start: 3px solid var(--dunya-bant);
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    line-height: 1.4;
  }

  .kenar-notu dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .kenar-notu dt {
    color: var(--soluk);
  }

  .kenar-notu dd {
    margin: 0;
    font-weight: 600;
  }

  /* Jenerik: ortalı, etiket küçük, değer büyük serif (koyu bantta, ≥ 24 px) */
  .jenerik {
    padding-block: clamp(4rem, 8vw, 8rem);
    text-align: center;
  }

  .jenerik-ic {
    display: grid;
    justify-items: center;
    gap: var(--aralik-5);
  }

  .jenerik-ic :global(.afis) {
    width: 9.5rem;
  }

  .liste {
    display: grid;
    gap: 1.1rem;
    margin: 0;
  }

  .liste dt {
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  .liste dd {
    margin: 0.1rem 0 0;
    font-family: var(--font-serif-yigin);
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .liste .puan {
    color: var(--turkuaz-metin);
  }

  .liste .puan span {
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--soluk);
  }
</style>
