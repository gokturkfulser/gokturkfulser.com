---
import Medya from '../Medya.astro';
import YaziKapagi from '../YaziKapagi.astro';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Etiketler from '../../components/Etiketler.astro';
import { mdxBilesenleri } from '../../components/mdx';
import { puanYaz, tarihIso, tarihYaz } from '../../lib/format';
import { filmYorumuLd, grafLd, makaleLd } from '../../lib/jsonld';
import { okumaSuresi } from '../../lib/okuma-suresi';
import { tmdbKaydi, tmdbUrl } from '../../lib/tmdb';

interface Props {
  entry: CollectionEntry<'sinema'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const { film } = data;

const tmdb = tmdbKaydi(film.tmdbId);
const orijinalAd = film.orijinalAd ?? tmdb?.orijinalBaslik;
const orijinal = orijinalAd && orijinalAd !== film.ad ? orijinalAd : undefined;
const sure = okumaSuresi(entry.body);
const ogYolu = `/og/sinema/${entry.id}.png`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogYolu, Astro.site).href;

const ld = grafLd(
  makaleLd({
    baslik: data.baslik,
    ozet: data.ozet,
    tarih: data.tarih,
    url,
    gorsel: ogUrl,
    bolumAdi: 'Sinema',
    etiketler: data.etiketler,
    kelime: sure.kelime,
    dakika: sure.dakika,
  }),
  ...(data.puan !== undefined
    ? [
        filmYorumuLd({
          baslik: data.baslik,
          ozet: data.ozet,
          tarih: data.tarih,
          url,
          film: { ad: film.ad, orijinalAd: orijinal, yil: film.yil, yonetmen: film.yonetmen },
          puan: data.puan,
          tmdbUrl: film.tmdbId ? tmdbUrl(film.tmdbId) : undefined,
        }),
      ]
    : []),
);
---

<Base baslik={data.baslik} aciklama={data.ozet} tur="article" ogGorsel={ogYolu} jsonLd={ld}>
  <article data-dunya="sinema" data-pagefind-body>
    <header>
      <div class="kapak-bant">
        <YaziKapagi class="kare" yazi={{ bolum: 'sinema', entry }} oran="kapak" width={1920} oncelikli />
      </div>
      <div class="bant bant--koyu jenerik">
        <div class="kap jenerik-ic">
          <h1 class="h1">{data.baslik}</h1>
          <p class="ozet">{data.ozet}</p>
          <div class="kunye-satiri">
            {
              tmdb?.afisGorsel && (
                <Medya
                  class="afis"
                  src={tmdb.afisGorsel}
                  oran="afis"
                  alt={`${film.ad} filminin afişi`}
                  width={320}
                  oncelikli
                />
              )
            }
            <dl>
              <dt>Film</dt>
              <dd>{film.ad}{orijinal && <> ({orijinal})</>}</dd>
              <dt>Yönetmen</dt>
              <dd>{film.yonetmen}</dd>
              <dt>Yıl</dt>
              <dd>{film.yil}</dd>
              {
                tmdb?.sure && (
                  <>
                    <dt>Süre</dt>
                    <dd>{tmdb.sure} dakika</dd>
                  </>
                )
              }
              {
                tmdb && tmdb.turler.length > 0 && (
                  <>
                    <dt>Tür</dt>
                    <dd>{tmdb.turler.join(', ')}</dd>
                  </>
                )
              }
              {
                data.puan !== undefined && (
                  <>
                    <dt>Puanım</dt>
                    <dd class="puan">
                      {puanYaz(data.puan)}{' '}<span>/ 5</span>
                    </dd>
                  </>
                )
              }
            </dl>
          </div>
          <p class="tarih">
            <time datetime={tarihIso(data.tarih)}>{tarihYaz(data.tarih)}</time>
            <span class="okuma">{sure.dakika} dakikalık okuma</span>
          </p>
        </div>
      </div>
    </header>

    <div class="bant bant--acik govde">
      <div class="kap">
        <div class="kolon">
          <div class="metin">
            <Content components={mdxBilesenleri} />
          </div>
          <Etiketler etiketler={data.etiketler} />
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .kapak-bant {
    width: 100%;
    background: var(--perde);
  }

  .kapak-bant :global(.kare) {
    border-radius: 0;
  }

  .jenerik {
    padding-block: clamp(3.5rem, 7vw, 8rem);
    text-align: center;
  }

  .jenerik-ic {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(3rem, 1rem + 8vw, 8.5rem);
  }

  .ozet {
    max-width: 34ch;
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--lede-renk);
  }

  .kunye-satiri {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--aralik-5) 3.5rem;
    width: 100%;
  }

  .kunye-satiri :global(.afis) {
    width: 9.5rem;
  }

  /* Jenerik: ortak eksende, soldaki etiket sağa, sağdaki ad sola yaslı */
  dl {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: var(--aralik-4);
    row-gap: var(--aralik-2);
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  dt {
    text-align: end;
    color: var(--soluk);
  }

  dd {
    margin: 0;
    text-align: start;
    font-weight: 600;
  }

  .puan {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--turkuaz-metin);
  }

  .puan span {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--soluk);
  }

  .tarih {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    font-weight: 500;
    color: var(--soluk);
  }

  .govde .kolon {
    max-width: 46rem;
    margin-inline: auto;
  }

  .govde :global(.etiketler) {
    margin-block-start: var(--aralik-5);
    padding-block-start: var(--aralik-4);
    border-block-start: 1px solid var(--cizgi);
  }

  @media (max-width: 36rem) {
    .kunye-satiri :global(.afis) {
      width: 7.5rem;
    }
  }
</style>
