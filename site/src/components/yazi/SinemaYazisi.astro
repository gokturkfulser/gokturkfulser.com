---
import Medya from '../Medya.astro';
import YaziBasi from './YaziBasi.astro';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Etiketler from '../../components/Etiketler.astro';
import { mdxBilesenleri } from '../../components/mdx';
import { puanYaz } from '../../lib/format';
import { filmYorumuLd, grafLd, makaleLd } from '../../lib/jsonld';
import { okumaSuresi } from '../../lib/okuma-suresi';
import { tmdbKaydi, tmdbUrl } from '../../lib/tmdb';
import { yaziCevirisi, yaziUrl } from '../../lib/content';
import { sozluk } from '../../i18n';
import { yol } from '../../i18n/yollar';

interface Props {
  entry: CollectionEntry<'sinema'>;
}

const { entry } = Astro.props;
const { data } = entry;
// Yazı kendi dilinin ağacında yaşar: künye, tarih ve etiketler yazının dilindedir.
const dil = data.dil;
const s = sozluk(dil);
const { Content } = await render(entry);
const { film } = data;

// Künyede ad yazının dilinde (TMDB'den; yoksa yazıdaki ad), özgün ad ikisinde de.
const tmdb = tmdbKaydi(film.tmdbId, dil);
const filmAdi = tmdb?.baslik ?? film.ad;
const orijinalAd = film.orijinalAd ?? tmdb?.orijinalBaslik;
const orijinal = orijinalAd && orijinalAd !== filmAdi ? orijinalAd : undefined;
const sure = okumaSuresi(entry.body, dil);
const ogYolu = yol.og(dil, 'sinema', entry.id);
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogYolu, Astro.site).href;

const ceviri = await yaziCevirisi({ bolum: 'sinema', entry });
const esdeger = ceviri ? { [dil]: yaziUrl({ bolum: 'sinema', entry }), [ceviri.entry.data.dil]: yaziUrl(ceviri) } : undefined;

const ld = grafLd(
  makaleLd({
    baslik: data.baslik,
    ozet: data.ozet,
    tarih: data.tarih,
    url,
    gorsel: ogUrl,
    bolumAdi: s.bolum.sinema,
    dil,
    etiketler: data.etiketler,
    kelime: sure.kelime,
    dakika: sure.dakika,
  }),
  ...(data.puan !== undefined
    ? [
        filmYorumuLd({
          baslik: data.baslik,
          ozet: data.ozet,
          tarih: data.tarih,
          url,
          dil,
          film: { ad: filmAdi, orijinalAd: orijinal, yil: film.yil, yonetmen: film.yonetmen },
          puan: data.puan,
          tmdbUrl: film.tmdbId ? tmdbUrl(film.tmdbId) : undefined,
        }),
      ]
    : []),
);
---

<Base
  baslik={data.baslik}
  aciklama={data.ozet}
  tur="article"
  ogGorsel={ogYolu}
  jsonLd={ld}
  bindirme
  {dil}
  {esdeger}
  yedek={{ en: yol.yazilar('en', 'sinema'), tr: yol.yazilar('tr', 'sinema') }}
>
  <article data-dunya="sinema" data-pagefind-body>
    <YaziBasi yazi={{ bolum: 'sinema', entry }} dakika={sure.dakika}>
      <span slot="meta">{film.yonetmen}, {film.yil}</span>
      {
        ceviri && (
          <a slot="meta" class="dil-gecisi" href={yaziUrl(ceviri)} hreflang={ceviri.entry.data.dil} lang={ceviri.entry.data.dil}>
            {sozluk(ceviri.entry.data.dil).nav.buDildeOku}
          </a>
        )
      }
    </YaziBasi>

    <!-- Kâğıt bandı: kapaktan sonra okuma alanı basılı sayfaya geçer (sert bant değişimi) -->
    <div class="bant bant--acik govde">
      <div class="kap">
        <div class="yazi-metni">
          <aside class="kenar-notu" aria-label={s.yazi.kunye}>
            <dl>
              <div>
                <dt>{s.yazi.film}</dt>
                <dd>{filmAdi}{orijinal && <> ({orijinal})</>}</dd>
              </div>
              <div>
                <dt>{s.yazi.yonetmen}</dt>
                <dd>{film.yonetmen}</dd>
              </div>
              <div>
                <dt>{s.yazi.yil}</dt>
                <dd>{film.yil}</dd>
              </div>
              {
                data.puan !== undefined && (
                  <div>
                    <dt>{s.yazi.puanim}</dt>
                    <dd>{puanYaz(data.puan, dil)} / 5</dd>
                  </div>
                )
              }
            </dl>
          </aside>
          <Content components={mdxBilesenleri} />
          <Etiketler etiketler={data.etiketler} {dil} />
        </div>
      </div>
    </div>

    <!-- Film künyesi yazının sonunda, jenerik düzeninde (koyu bant) -->
    <section class="bant bant--koyu jenerik" aria-labelledby="jenerik-baslik">
      <div class="kap jenerik-ic">
        <h2 id="jenerik-baslik" class="sr-only">{s.yazi.filmKunyesi}</h2>
        {
          tmdb?.afisGorsel && (
            <Medya class="afis" src={tmdb.afisGorsel} oran="afis" alt={s.yazi.afisAlt(filmAdi)} width={320} />
          )
        }
        <dl class="liste">
          <div>
            <dt>{s.yazi.film}</dt>
            <dd>{filmAdi}{orijinal && <> ({orijinal})</>}</dd>
          </div>
          <div>
            <dt>{s.yazi.yonetmen}</dt>
            <dd>{film.yonetmen}</dd>
          </div>
          <div>
            <dt>{s.yazi.yapimYili}</dt>
            <dd>{film.yil}</dd>
          </div>
          {
            tmdb?.sure && (
              <div>
                <dt>{s.yazi.sure}</dt>
                <dd>{s.yazi.dakika(tmdb.sure)}</dd>
              </div>
            )
          }
          {
            tmdb && tmdb.turler.length > 0 && (
              <div>
                <dt>{s.yazi.tur}</dt>
                <dd>{tmdb.turler.join(', ')}</dd>
              </div>
            )
          }
          {
            data.puan !== undefined && (
              <div>
                <dt>{s.yazi.puanim}</dt>
                <dd class="puan">{puanYaz(data.puan, dil)} <span>/ 5</span></dd>
              </div>
            )
          }
        </dl>
      </div>
    </section>
  </article>
</Base>

<style>
  /* Dil geçişi: kapaktaki meta satırında, koyu bantta; çizgisi sürekli (bağlantı olduğu belli olsun) */
  .dil-gecisi {
    color: var(--vurgu);
    font-weight: 600;
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }

  .govde {
    padding-block-start: calc(var(--bant) * 0.7);
    padding-block-end: calc(var(--bant) * 0.7);
  }

  .govde :global(.etiketler) {
    margin-block-start: var(--aralik-5);
    padding-block-start: var(--aralik-4);
    border-block-start: 1px solid var(--cizgi);
  }

  /* Kenar notu (künye): Hanken, kâğıt */
  .kenar-notu {
    padding-block-start: 0.6rem;
    border-block-start: 3px solid var(--dunya-bant);
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    line-height: 1.4;
  }

  .kenar-notu dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .kenar-notu dt {
    color: var(--soluk);
  }

  .kenar-notu dd {
    margin: 0;
    font-weight: 600;
  }

  /* Jenerik: ortalı, etiket küçük, değer büyük serif (koyu bantta, ≥ 24 px) */
  .jenerik {
    padding-block: clamp(4rem, 8vw, 8rem);
    text-align: center;
  }

  .jenerik-ic {
    display: grid;
    justify-items: center;
    gap: var(--aralik-5);
  }

  .jenerik-ic :global(.afis) {
    width: 9.5rem;
  }

  .liste {
    display: grid;
    gap: 1.1rem;
    margin: 0;
  }

  .liste dt {
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  .liste dd {
    margin: 0.1rem 0 0;
    font-family: var(--font-serif-yigin);
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .liste .puan {
    color: var(--turkuaz-metin);
  }

  .liste .puan span {
    font-family: var(--font-baslik-yigin);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--soluk);
  }
</style>
