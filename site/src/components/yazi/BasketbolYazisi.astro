---
import YaziBasi from './YaziBasi.astro';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Etiketler from '../../components/Etiketler.astro';
import { mdxBilesenleri } from '../../components/mdx';
import DisBaglanti from '../../components/mdx/DisBaglanti.astro';
import { yaziCevirisi, yaziUrl } from '../../lib/content';
import { grafLd, makaleLd } from '../../lib/jsonld';
import { okumaSuresi } from '../../lib/okuma-suresi';
import { listeYaz, sozluk } from '../../i18n';
import { yol } from '../../i18n/yollar';

interface Props {
  entry: CollectionEntry<'basketbol'>;
}

const { entry } = Astro.props;
const { data } = entry;
// Yazı kendi dilinin ağacında yaşar: künye, tarih ve etiketler yazının dilindedir.
const dil = data.dil;
const s = sozluk(dil);
const { Content } = await render(entry);
const sure = okumaSuresi(entry.body, dil);
const ogYolu = yol.og(dil, 'basketbol', entry.id);
const url = new URL(Astro.url.pathname, Astro.site).href;
// Diğer dildeki karşılık (varsa): nav'daki dil düğmesi, hreflang ve kapaktaki "oku" bağlantısı buradan bağlanır.
const kendi = { bolum: 'basketbol' as const, entry };
const ceviri = await yaziCevirisi(kendi);
const esdeger = ceviri ? { [dil]: yaziUrl(kendi), [ceviri.entry.data.dil]: yaziUrl(ceviri) } : undefined;
const ld = grafLd(
  makaleLd({
    baslik: data.baslik,
    ozet: data.ozet,
    tarih: data.tarih,
    url,
    gorsel: new URL(ogYolu, Astro.site).href,
    bolumAdi: s.bolum.basketbol,
    dil,
    etiketler: data.etiketler,
    kelime: sure.kelime,
    dakika: sure.dakika,
  }),
);
const bilgi = [
  data.sezon && { ad: s.yazi.sezon, deger: data.sezon },
  data.takimlar?.length && { ad: s.yazi.takimlar, deger: listeYaz(data.takimlar, dil) },
  data.oyuncular?.length && { ad: s.yazi.oyuncular, deger: listeYaz(data.oyuncular, dil) },
].filter((b): b is { ad: string; deger: string } => Boolean(b));
---

<Base
  baslik={data.baslik}
  aciklama={data.ozet}
  tur="article"
  ogGorsel={ogYolu}
  jsonLd={ld}
  bindirme
  {dil}
  {esdeger}
  yedek={{ en: yol.yazilar('en', 'basketbol'), tr: yol.yazilar('tr', 'basketbol') }}
>
  <article data-dunya="basketbol" data-pagefind-body>
    <YaziBasi yazi={{ bolum: 'basketbol', entry }} dakika={sure.dakika}>
      {
        ceviri && (
          <a slot="meta" class="dil-gecisi" href={yaziUrl(ceviri)} hreflang={ceviri.entry.data.dil} lang={ceviri.entry.data.dil}>
            {sozluk(ceviri.entry.data.dil).nav.buDildeOku}
          </a>
        )
      }
    </YaziBasi>
    <!-- Kâğıt bandı: kapaktan sonra okuma alanı basılı sayfaya geçer (sert bant değişimi) -->
    <div class="bant bant--acik govde">
      <div class="kap">
        <div class="yazi-metni">
          {
            bilgi.length > 0 && (
              <aside class="kenar-notu" aria-label={s.yazi.kunye}>
                <dl>
                  {bilgi.map((b) => (
                    <div>
                      <dt>{b.ad}</dt>
                      <dd>{b.deger}</dd>
                    </div>
                  ))}
                </dl>
              </aside>
            )
          }
          <Content components={{ ...mdxBilesenleri, a: DisBaglanti }} />
          <Etiketler etiketler={data.etiketler} {dil} />
        </div>
      </div>
    </div>
    {
      data.istatistik && (
        <section class="bant bant--koyu skorbord" aria-labelledby="skor-baslik">
          <div class="kap">
            <h2 id="skor-baslik" class="sr-only">{s.yazi.macIstatistikleri}</h2>
            <dl class="skor">
              {data.istatistik.map((i) => (
                <div>
                  <dt>{i.etiket}</dt>
                  <dd>{i.deger}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  /* Dil geçişi: kapaktaki meta satırında, koyu bantta; çizgisi odakta/hover'da (base.css) değil sürekli (bağlantı olduğu belli olsun) */
  .dil-gecisi {
    color: var(--vurgu);
    font-weight: 600;
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }

  .govde {
    padding-block-start: calc(var(--bant) * 0.7);
    padding-block-end: calc(var(--bant) * 0.7);
  }

  .govde :global(.etiketler) {
    margin-block-start: var(--aralik-5);
    padding-block-start: var(--aralik-4);
    border-block-start: 1px solid var(--cizgi);
  }

  .kenar-notu {
    padding-block-start: 0.6rem;
    border-block-start: 3px solid var(--dunya-bant);
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-xs);
    line-height: 1.4;
  }

  .kenar-notu dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .kenar-notu dt {
    color: var(--soluk);
  }

  .kenar-notu dd {
    margin: 0;
    font-weight: 600;
  }

  /* Skorbord (koyu bant, yazının sonunda): sayılar büyük serif, etiket küçük; veri frontmatter'dan gelir */
  .skorbord {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .skor {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-4) var(--aralik-5);
    margin: 0;
  }

  .skor > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .skor dd {
    margin: 0;
    font-family: var(--font-serif-yigin);
    font-weight: 500;
    font-size: clamp(3.5rem, 2rem + 5vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--turuncu-metin);
  }

  .skor dt {
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    color: var(--soluk);
  }
</style>
