---
import YaziKapagi from '../YaziKapagi.astro';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Etiketler from '../../components/Etiketler.astro';
import { mdxBilesenleri } from '../../components/mdx';
import { tarihIso, tarihYaz } from '../../lib/format';
import { grafLd, makaleLd } from '../../lib/jsonld';
import { okumaSuresi } from '../../lib/okuma-suresi';

interface Props {
  entry: CollectionEntry<'basketbol'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const sure = okumaSuresi(entry.body);
const ogYolu = `/og/basketbol/${entry.id}.png`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = grafLd(
  makaleLd({
    baslik: data.baslik,
    ozet: data.ozet,
    tarih: data.tarih,
    url,
    gorsel: new URL(ogYolu, Astro.site).href,
    bolumAdi: 'Basketbol',
    etiketler: data.etiketler,
    kelime: sure.kelime,
    dakika: sure.dakika,
  }),
);
const liste = new Intl.ListFormat('tr-TR', { style: 'long', type: 'conjunction' });
const bilgi = [
  data.sezon && { ad: 'Sezon', deger: data.sezon },
  data.takimlar?.length && { ad: 'Takımlar', deger: liste.format(data.takimlar) },
  data.oyuncular?.length && { ad: 'Oyuncular', deger: liste.format(data.oyuncular) },
].filter((b): b is { ad: string; deger: string } => Boolean(b));
---

<Base baslik={data.baslik} aciklama={data.ozet} tur="article" ogGorsel={ogYolu} jsonLd={ld}>
  <article data-dunya="basketbol" data-pagefind-body>
    <header>
      <div class="bant bant--koyu bant--basi">
        <div class="kap baslik-ic">
          <h1 class="h1">{data.baslik}</h1>
          <p class="lede">{data.ozet}</p>
          {
            bilgi.length > 0 && (
              <dl class="bilgi">
                {bilgi.map((b) => (
                  <div>
                    <dt>{b.ad}</dt>
                    <dd>{b.deger}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          {
            data.istatistik && (
              <dl class="skor" aria-label="Maç istatistikleri">
                {data.istatistik.map((s) => (
                  <div>
                    <dt>{s.etiket}</dt>
                    <dd>{s.deger}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          <p class="tarih">
            <time datetime={tarihIso(data.tarih)}>{tarihYaz(data.tarih)}</time>
            <span class="okuma">{sure.dakika} dakikalık okuma</span>
          </p>
        </div>
      </div>
      <div class="bant--koyu kapak-bant">
        <div class="kap">
          <YaziKapagi yazi={{ bolum: 'basketbol', entry }} oran="kapak" width={1600} oncelikli />
        </div>
      </div>
    </header>

    <div class="bant bant--acik govde">
      <div class="kap">
        <div class="kolon">
          <div class="metin">
            <Content components={mdxBilesenleri} />
          </div>
          <Etiketler etiketler={data.etiketler} />
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .baslik-ic {
    display: grid;
    gap: var(--aralik-4);
  }

  h1 {
    max-width: 14ch;
  }

  .lede {
    max-width: 40ch;
  }

  .bilgi {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-2) var(--aralik-5);
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: 1.0625rem;
  }

  .bilgi dt {
    font-size: var(--yazi-xs);
    color: var(--soluk);
  }

  .bilgi dd {
    margin: 0;
    font-weight: 600;
  }

  /* Skorbord: sayılar büyük, etiket küçük; veri frontmatter'dan gelir */
  .skor {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aralik-3) var(--aralik-5);
    margin: 0;
    padding-block-start: var(--aralik-4);
    border-block-start: 1px solid var(--cizgi);
  }

  .skor > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .skor dd {
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-weight: 800;
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--turuncu-metin);
  }

  .skor dt {
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    color: var(--soluk);
  }

  .tarih {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    font-family: var(--font-baslik-yigin);
    font-size: var(--yazi-sm);
    font-weight: 500;
    color: var(--soluk);
  }

  .kapak-bant {
    width: 100%;
    padding-block-end: var(--bant);
  }

  .govde .kolon {
    max-width: 46rem;
    margin-inline: auto;
  }

  .govde :global(.etiketler) {
    margin-block-start: var(--aralik-5);
    padding-block-start: var(--aralik-4);
    border-block-start: 1px solid var(--cizgi);
  }
</style>
