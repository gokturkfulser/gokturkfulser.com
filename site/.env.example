# Bu dosyayı .env olarak kopyalayıp doldurun. .env repo'ya girmez; gerçek değerler buraya yazılmaz.

# Preview build'lerinde taslak içerikleri göstermek için true yapın.
# Production'da tanımlamayın veya false bırakın.
SHOW_DRAFTS=false

# TMDB (yalnızca `pnpm site:tmdb` çalıştırırken gerekir; build bu anahtarı kullanmaz).
# v3 API anahtarı ya da v4 "API Read Access Token" olabilir. https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# İsteğe bağlı: Letterboxd günlük RSS adresi (https://letterboxd.com/<kullanici>/rss/).
# Tanımlıysa ana sayfada build sırasında "Son izlediklerim" şeridi çekilir; tanımlı değilse hiç çizilmez.
LETTERBOXD_RSS=

# İsteğe bağlı: Cloudflare Web Analytics token'ı. Tanımlıysa beacon script'i eklenir
# (tanımlıyken yazı sayfalarında da 1 harici script yüklenir); tanımlı değilse hiç eklenmez.
CF_ANALYTICS_TOKEN=
