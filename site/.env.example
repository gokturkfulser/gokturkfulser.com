# Bu dosyayı .env olarak kopyalayıp doldurun. .env repo'ya girmez; gerçek değerler buraya yazılmaz.

# Preview build'lerinde taslak içerikleri göstermek için true yapın.
# Production'da tanımlamayın veya false bırakın.
SHOW_DRAFTS=false

# TMDB: `pnpm site:tmdb` (yazı verisi) ve her build'in başındaki Letterboxd afiş indirmesi (`pnpm --filter site afisler`) kullanır.
# Anahtar yoksa build yine başarılı olur, şerit afişsiz çizilir.
# v3 API anahtarı ya da v4 "API Read Access Token" olabilir. https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# İsteğe bağlı: Letterboxd günlük RSS adresi (https://letterboxd.com/<kullanici>/rss/).
# Tanımlıysa ana sayfada build sırasında "Son izlediklerim" şeridi çekilir; tanımlı değilse hiç çizilmez.
LETTERBOXD_RSS=

# İsteğe bağlı: Cloudflare Web Analytics token'ı. Tanımlıysa beacon script'i eklenir
# (tanımlıyken yazı sayfalarında da 1 harici script yüklenir); tanımlı değilse hiç eklenmez.
CF_ANALYTICS_TOKEN=

# Top 10 otomasyonu (scripts/top10, workflow: .github/workflows/site-top10.yml). Yerelde denemek için; production sırları GitHub secret'tır.
# YouTube Data API v3 anahtarı (Google Cloud Console → APIs & Services → Credentials). Yalnızca playlistItems/videos okur.
YOUTUBE_API_KEY=
# Gemini API anahtarı (aistudio.google.com/apikey).
GEMINI_API_KEY=
# İsteğe bağlı: Gemini model kimliği; boşsa scripts/top10/ayarlar.ts içindeki varsayılan (gemini-3.8-flash).
GEMINI_MODEL=
# İsteğe bağlı: Gemini'ye giden video çözünürlüğü (unspecified|low|medium|high|ultra_high); boşsa high. Düşük çözünürlük daha az token harcar.
GEMINI_COZUNURLUK=
